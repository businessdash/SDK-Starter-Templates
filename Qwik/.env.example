# ═══════════════════════════════════════════════════════════════════
# BIAB Web Content SDK
#
# Easiest path: open the guided wizard in your BIAB dashboard —
#   Settings → Web Content SDK   (https://www.biab.app/login?returnTo=/dashboard/settings/web-content)
# It creates every value below and hands you a copy-paste block.
#
# Each variable maps to a spot in the dashboard:
#   PUBLIC_BIAB_SITE_ID  → Site Builder ▸ Developer ▸ "Site ID"
#   BIAB_API_KEY              → Site Builder ▸ Developer ▸ "Secret keys"
#   PUBLIC_BIAB_PK       → Site Builder ▸ Developer ▸ "Publishable tokens"
#   BIAB_REVALIDATION_SECRET  → the wizard, or Settings ▸ Integrations
#
# The PUBLIC_ vars are exposed to the browser via Vite's envPrefix
# (see vite.config.ts). The starter's original PUBLIC_BIAB_* names — and the
# plain BIAB_SITE_ID / BIAB_PACKAGE_API_BASE_URL — still work as a fallback,
# so existing .env files keep running unchanged.
# ═══════════════════════════════════════════════════════════════════

# ── Non-secret + browser-safe (the browser needs these) ─────────────
# Where BIAB is hosted (defaults to production when unset). Read by both the
# server helpers and the browser (followers + analytics).
PUBLIC_BIAB_PACKAGE_API_BASE_URL=https://www.biab.app

# The site UUID this app renders.
PUBLIC_BIAB_SITE_ID=

# Publishable token (`pk_…`): origin-locked, rate-limited, browser-safe. Powers
# the newsletter signup + the visitor analytics tracker from the client. When it
# + SITE_ID are unset, those surfaces degrade to placeholders (the app still runs).
PUBLIC_BIAB_PK=

# ── Server-only secrets — NEVER prefix these with PUBLIC_ ──────
# Secret API key (`sk_…`) for authenticated server-side reads.
BIAB_API_KEY=

# HMAC secret for the BIAB → this-app revalidate webhook (`whsec_…`). Lets BIAB
# tell the site to refresh the instant content changes (no polling).
BIAB_REVALIDATION_SECRET=

# Public, fully-qualified URL of your auth handler's /callback route.
# Required for sign-in / sign-up / customer portal. Register it as a
# redirect URI in your BIAB site's WorkOS settings.
#   Prod: https://www.your-site.com/api/biab-auth/callback
#   Dev:  http://localhost:5173/api/biab-auth/callback
BIAB_AUTH_CALLBACK_URL=
