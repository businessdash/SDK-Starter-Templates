{
  "name": "bd-qwik",
  "description": "BD SDK starter on Qwik City",
  "engines": {
    "node": "^20.9.0 || >=21.0.0"
  },
  "engines-annotation": "Mostly required by sharp which needs a Node-API v9 compatible runtime",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "qwik build",
    "build.client": "vite build",
    "build.preview": "vite build --ssr src/entry.preview.tsx",
    "build.types": "tsc --incremental --noEmit",
    "deploy": "echo 'Run \"npm run qwik add\" to install a server adapter'",
    "dev": "vite --mode ssr",
    "dev.debug": "node --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --force",
    "fmt": "prettier --write .",
    "fmt.check": "prettier --check .",
    "lint": "eslint \"src/**/*.ts*\"",
    "preview": "qwik build preview && vite preview --open",
    "start": "vite --open --mode ssr",
    "qwik": "qwik",
    "sync-schema": "tsx node_modules/@businessdash/sdk/dist/cli.js sync-schema --config bd.config.ts",
    "sync-content": "tsx node_modules/@businessdash/sdk/dist/cli.js sync-content --config bd.config.ts",
    "print-schema": "tsx node_modules/@businessdash/sdk/dist/cli.js print-schema --config bd.config.ts",
    "sync-data-model": "tsx node_modules/@businessdash/sdk/dist/cli.js sync-data-model --config bd.data-model.config.ts",
    "print-data-model": "tsx node_modules/@businessdash/sdk/dist/cli.js print-data-model --config bd.data-model.config.ts"
  },
  "dependencies": {
    "@businessdash/sdk": "^0.9.90",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@builder.io/qwik": "^1.20.0",
    "tsx": "^4.22.3",
    "@builder.io/qwik-city": "^1.20.0",
    "@eslint/js": "^9",
    "@types/node": "20.19.0",
    "eslint": "9.32.0",
    "eslint-plugin-qwik": "^1.20.0",
    "globals": "16.4.0",
    "prettier": "3.6.2",
    "typescript": "5.4.5",
    "typescript-eslint": "8.38.0",
    "typescript-plugin-css-modules": "latest",
    "undici": "^6.28.0",
    "vite": "^7.3.2",
    "vite-tsconfig-paths": "^4.2.1"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.28.1",
      "sharp@<0.35.0": ">=0.35.3 <0.36.0",
      "undici": "^6.28.0"
    }
  }
}
