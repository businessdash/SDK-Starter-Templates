# Copy this ".env.example" to ".env" and fill in real values. Both the server
# (createServerFn handlers + API routes) and the Vite browser bundle read it.
#
# This file IS committed to version control, so never put real secrets in it.

# ═══════════════════════════════════════════════════════════════════
# BIAB Web Content SDK
#
# Easiest path: open the guided wizard in your BIAB dashboard —
#   Settings → Web Content SDK   (https://www.biab.app/login?returnTo=/dashboard/settings/web-content)
# It creates every value below and hands you a copy-paste block.
#
# Each variable maps to a spot in the dashboard:
#   VITE_BIAB_SITE_ID  → Site Builder ▸ Developer ▸ "Site ID"
#   BIAB_API_KEY              → Site Builder ▸ Developer ▸ "Secret keys"
#   VITE_BIAB_PK       → Site Builder ▸ Developer ▸ "Publishable tokens"
#   BIAB_REVALIDATION_SECRET  → the wizard, or Settings ▸ Integrations
# ═══════════════════════════════════════════════════════════════════

# ── Non-secret + browser-safe (the browser needs these) ─────────────
# Where BIAB is hosted (defaults to production when unset).
VITE_BIAB_PACKAGE_API_BASE_URL=https://www.biab.app

# The site UUID this app renders.
VITE_BIAB_SITE_ID=

# Publishable token (`pk_…`): origin-locked, rate-limited, scoped to
# `followers:self` — browser-safe. Powers the newsletter Subscribe component
# and client-side analytics. When it + SITE_ID are unset, those surfaces degrade
# to placeholders (the app still runs).
VITE_BIAB_PK=

# ── Server-only secrets — NEVER prefix these with VITE_ ──────
# Secret API key (`sk_…`) for authenticated server-side reads. Held by the
# createServerFn handlers — it never reaches the browser bundle.
BIAB_API_KEY=

# HMAC secret for the BIAB → this-app revalidate webhook (`whsec_…`). Lets BIAB
# tell the site to refresh the instant content changes (no polling).
BIAB_REVALIDATION_SECRET=

# Public, fully-qualified URL of your auth handler's /callback route.
# Required for sign-in / sign-up / customer portal. Register it as a
# redirect URI in your BIAB site's WorkOS settings.
#   Prod: https://www.your-site.com/api/biab-auth/callback
#   Dev:  http://localhost:3000/api/biab-auth/callback
BIAB_AUTH_CALLBACK_URL=

# ── Legacy aliases (still honored, no need to set if you use the above) ──
# Older setups used the plain server names + VITE_-prefixed browser twins.
# They still work as fallbacks, so existing .env files keep running:
#   BIAB_SITE_ID / BIAB_PACKAGE_API_BASE_URL              (server)
#   VITE_BIAB_SITE_ID / VITE_BIAB_PUBLIC_KEY /
#   VITE_BIAB_PACKAGE_API_BASE_URL                        (browser)
