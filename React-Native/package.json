{
  "name": "biab-expo-starter",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "sync-schema": "tsx node_modules/@businessdash/sdk/dist/cli.js sync-schema --config biab.config.ts",
    "sync-content": "tsx node_modules/@businessdash/sdk/dist/cli.js sync-content --config biab.config.ts",
    "print-schema": "tsx node_modules/@businessdash/sdk/dist/cli.js print-schema --config biab.config.ts",
    "sync-data-model": "tsx node_modules/@businessdash/sdk/dist/cli.js sync-data-model --config biab.data-model.config.ts",
    "print-data-model": "tsx node_modules/@businessdash/sdk/dist/cli.js print-data-model --config biab.data-model.config.ts",
    "view-data-model": "tsx node_modules/@businessdash/sdk/dist/cli.js view-data-model",
    "seed": "tsx node_modules/@businessdash/sdk/dist/cli.js sync-records --records-dir ./biab-records"
  },
  "dependencies": {
    "@businessdash/sdk": "^0.9.70",
    "@react-native-async-storage/async-storage": "2.1.0",
    "expo": "~52.0.0",
    "expo-crypto": "~14.0.1",
    "expo-linking": "~7.0.3",
    "expo-router": "~4.0.9",
    "expo-secure-store": "~14.0.0",
    "expo-status-bar": "~2.0.0",
    "expo-web-browser": "~14.0.1",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "tsx": "^4.22.4",
    "typescript": "~5.3.3"
  }
}
