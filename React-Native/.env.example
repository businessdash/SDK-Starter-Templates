# ═══════════════════════════════════════════════════════════════════
# BD Web Content SDK — Expo starter
#
# Expo DOES have a public-var convention, unlike the other mobile starters:
# anything prefixed EXPO_PUBLIC_ is inlined into the JS bundle at build time.
#
# That prefix is an instruction to the bundler — "publish this" — so it is
# exactly and only correct for values that are safe to publish. Every var
# below is, because a mobile app can only ever hold a publishable token.
# ═══════════════════════════════════════════════════════════════════

EXPO_PUBLIC_BD_HOST=https://www.biab.app

# The site UUID this app renders.
EXPO_PUBLIC_BD_SITE_ID=

# ⚠️ PUBLISHABLE TOKEN ONLY (`pk_…`).
#
# EXPO_PUBLIC_ vars are compiled into the bundle, and `strings` on the built
# app finds them. Never put an `sk_…` key here — `createClient()` throws if
# you do.
#
# The publishable scope set covers the entire customer-facing surface:
# storefront, cart, checkout, blog, marketing content, chat, forms, the whole
# customer portal, sign-in, and public custom-object reads. Only operator or
# admin writes need a secret key, and a customer app never makes those.
EXPO_PUBLIC_BD_PK=
