# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Drizzle — OPTIONAL. The BD Web Content SDK needs no database. Set this only
# if you use this starter's example tRPC/DB features; without it the app still
# boots and renders BD content (accessing `db` throws a helpful error).
# DATABASE_URL="postgresql://postgres:password@localhost:5432/T3-App"

# ═══════════════════════════════════════════════════════════════════
# BD Web Content SDK
#
# Easiest path: open the guided wizard in your BD dashboard —
#   Settings → Web Content SDK   (https://www.biab.app/login?returnTo=/dashboard/settings/web-content)
# It creates every value below and hands you a copy-paste block.
#
# Each variable maps to a spot in the dashboard:
#   NEXT_PUBLIC_BD_SITE_ID  → Site Builder ▸ Developer ▸ "Site ID"
#   BD_API_KEY              → Site Builder ▸ Developer ▸ "Secret keys"
#   NEXT_PUBLIC_BD_PK       → Site Builder ▸ Developer ▸ "Publishable tokens"
#   BD_REVALIDATION_SECRET  → Settings ▸ Integrations ▸ Revalidation webhook
# ═══════════════════════════════════════════════════════════════════

# ── Non-secret + browser-safe (the browser needs these) ─────────────
# Where BD is hosted (defaults to production when unset).
NEXT_PUBLIC_BD_PACKAGE_API_BASE_URL=https://www.biab.app

# The site UUID this app renders.
NEXT_PUBLIC_BD_SITE_ID=

# Publishable token (`pk_…`): origin-locked, rate-limited, browser-safe. Powers
# the newsletter signup, forms, and storefront reads from the client. When it +
# SITE_ID are unset, those components degrade to placeholders (the app still runs).
NEXT_PUBLIC_BD_PK=

# ── Server-only secrets — NEVER prefix these with NEXT_PUBLIC_ ──────
# Secret API key (`sk_…`) for authenticated server-side reads.
BD_API_KEY=

# HMAC secret for the BD → this-app revalidate webhook (`whsec_…`). Lets BD
# tell the site to refresh the instant content changes (no polling).
BD_REVALIDATION_SECRET=

# Public, fully-qualified URL of your auth handler's /callback route.
# Required for sign-in / sign-up / customer portal. Register it as a
# redirect URI in your BD site's WorkOS settings.
#   Prod: https://www.your-site.com/api/bd-auth/callback
#   Dev:  http://localhost:3000/api/bd-auth/callback
BD_AUTH_CALLBACK_URL=

# Production origin used in server-side JSON-LD (LocalBusiness / WebSite).
# Safe to expose. Falls back to https://example.com when unset.
NEXT_PUBLIC_SITE_URL=
