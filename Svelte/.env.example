# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# ── Drizzle / libSQL — OPTIONAL ─────────────────────────────────────
# The BD Web Content SDK needs NO database. This template ships an example
# Drizzle/libSQL setup behind DATABASE_URL, which is now optional — without it
# the app still boots and renders BD content (touching `db` throws a helpful
# error, never at boot). Set it only if you use this starter's example DB
# features.
# DATABASE_URL=file:local.db

# ═══════════════════════════════════════════════════════════════════
# BD Web Content SDK
#
# Easiest path: open the guided wizard in your BD dashboard —
#   Settings → Web Content SDK   (https://www.biab.app/login?returnTo=/dashboard/settings/web-content)
# It creates every value below and hands you a copy-paste block.
#
# Each variable maps to a spot in the dashboard:
#   PUBLIC_BD_SITE_ID      → Site Builder ▸ Developer ▸ "Site ID"
#   BD_API_KEY             → Site Builder ▸ Developer ▸ "Secret keys"
#   PUBLIC_BD_PK   → Site Builder ▸ Developer ▸ "Publishable tokens"
#   BD_REVALIDATION_SECRET → the wizard, or Settings ▸ Integrations
#
# SvelteKit note: browser-exposed vars use the PUBLIC_ prefix (read via
# $env/static|dynamic/public). Server-only secrets carry no prefix (read via
# $env/dynamic/private) and never reach the client bundle. Existing setups on
# the older server-only names (BD_SITE_ID / BD_PACKAGE_API_BASE_URL) keep
# working — the server lib falls back to them.
# ═══════════════════════════════════════════════════════════════════

# ── Non-secret + browser-safe (the browser needs these) ─────────────
# Where BD is hosted (defaults to production when unset).
PUBLIC_BD_PACKAGE_API_BASE_URL=https://www.biab.app

# The site UUID this app renders.
PUBLIC_BD_SITE_ID=

# Publishable token (`pk_…`): origin-locked, rate-limited, browser-safe. Powers
# client-side analytics + the newsletter signup. When it + SITE_ID are unset,
# those components degrade to placeholders (the app still runs).
PUBLIC_BD_PK=

# ── Server-only secrets — NEVER prefix these with PUBLIC_ ────────────
# Secret API key (`sk_…`) for authenticated server-side reads.
BD_API_KEY=

# HMAC secret for the BD → this-app revalidate webhook (`whsec_…`). Lets BD
# tell the site to refresh the instant content changes (no polling). Paste the
# value the BD admin UI reveals at /dashboard/settings/integrations.
BD_REVALIDATION_SECRET=

# Optional: public, fully-qualified URL of your auth handler's /callback
# route. Required for sign-in / sign-up / customer portal. Register it as
# a redirect URI in your BD site's WorkOS settings.
#   Prod: https://www.your-site.com/api/bd-auth/callback
#   Dev:  http://localhost:<port>/api/bd-auth/callback
BD_AUTH_CALLBACK_URL=
