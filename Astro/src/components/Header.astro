---
/**
 * Server-rendered nav. Reads the customer session server-side so the header
 * reflects signed-in state without client JS. The cart, wishlist and compare
 * links live in the store bar (`StoreNav.astro`) on the store's pages.
 *
 * Auth uses plain `<a href="/api/bd-auth/*">` links (the handler is mounted
 * at that catch-all). Sign-out points at the same handler, which clears the
 * `bd_session` cookie and redirects home.
 */
import { getCustomerSession } from "../lib/bd-portal";

const session = await getCustomerSession(Astro.cookies).catch(() => null);
const firstName = session?.user.firstName ?? null;
---

<header class="app-header">
	<div class="app-header__inner">
		<a class="app-header__brand" href="/">Your Business</a>
		<nav>
			<a href="/#services">Services</a>
			<!-- [bd:store] -->
			<a href="/store">Store</a>
			<!-- [/bd:store] -->
			<!-- [bd:subscriptions] -->
			<!-- [bd:!store] -->
			<a href="/store/subscriptions">Plans</a>
			<!-- [/bd:!store] -->
			<!-- [/bd:subscriptions] -->
			<a href="/#gallery">Gallery</a>
			<!-- [bd:booking] -->
			<a href="/#booking">Book</a>
			<!-- [/bd:booking] -->
			<a href="/reviews">Reviews</a>
			<a href="/updates">Updates</a>
			<!-- [bd:blog] -->
			<a href="/blog">Blog</a>
			<!-- [/bd:blog] -->
			<a href="/#contact">Contact</a>
		</nav>
		<div class="app-header__actions">
			{
				session ? (
					<>
						<a href="/my-account">{firstName ? `Hi, ${firstName}` : "My account"}</a>
						<a class="bd-btn bd-btn--ghost" href="/api/bd-auth/sign-out">
							Sign out
						</a>
					</>
				) : (
					<>
						<a href="/my-account">Sign in</a>
						<a class="bd-btn" href="/my-account?start=create">
							Sign up
						</a>
					</>
				)
			}
		</div>
	</div>
</header>
