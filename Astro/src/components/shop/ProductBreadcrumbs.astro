---
// [bd-file:store]
/** Store / Category / This product. */
import type { ProductView } from "../../lib/bd-shop/shop";

interface Props {
	product: ProductView;
	storeHref?: string;
}
const { product, storeHref = "/store" } = Astro.props;
---

<nav aria-label="Breadcrumb" class="crumbs">
	<a href={storeHref}>Store</a>
	{
		product.categoryId ? (
			<>
				<span aria-hidden="true">/</span>
				<a href={`${storeHref}?category=${encodeURIComponent(product.categoryId)}`}>
					{product.categoryName ?? "Category"}
				</a>
			</>
		) : null
	}
	<span aria-hidden="true">/</span>
	<span aria-current="page">{product.name}</span>
</nav>
