---
// [bd-file:store]
/** Secure checkout, and a link to ask before buying. */
interface Props {
	contactHref?: string;
}
const { contactHref = "/#contact" } = Astro.props;
---

<ul class="policies">
	<li>Secure checkout with Stripe</li>
	<li>Questions? <a href={contactHref}>Ask us</a> before you buy</li>
</ul>
