---
// [bd-file:store]
/**
 * The whole product page: photos that follow the chosen option, option and
 * size buttons, the price for what's chosen, add to cart, save and compare,
 * share, details, add-ons, reviews, related products and what was viewed
 * before.
 *
 * It's laid out from the parts imported below, one file each, drawn on the
 * server as the page opens (the first variant that can be bought, nothing
 * else chosen). `<bd-gallery>` and `<bd-product-form>`
 * (src/lib/bd-shop/shop-elements.ts) bring them to life: they find the parts
 * by their data-bd attributes, so move, restyle or drop any part, or lay
 * them out your own way.
 */
import {
	allOptionGroups,
	defaultVariant,
	optionGroupsFor,
	type ProductPageData,
	photoSets,
	priceFor,
	productSummary,
	type SavedProduct,
	toProductView,
} from "../../lib/bd-shop/shop";
import AddToCartButton from "./AddToCartButton.astro";
import CartNotice from "./CartNotice.astro";
import CompareBar from "./CompareBar.astro";
import OptionPicker from "./OptionPicker.astro";
import ProductAddons from "./ProductAddons.astro";
import ProductBreadcrumbs from "./ProductBreadcrumbs.astro";
import ProductGallery from "./ProductGallery.astro";
import ProductPolicies from "./ProductPolicies.astro";
import ProductPrice from "./ProductPrice.astro";
import ProductRail from "./ProductRail.astro";
import ProductReviews from "./ProductReviews.astro";
import ProductSpecs from "./ProductSpecs.astro";
import ProductTitle from "./ProductTitle.astro";
import QuantityStepper from "./QuantityStepper.astro";
import RecentlyViewed from "./RecentlyViewed.astro";
import SaveButtons from "./SaveButtons.astro";
import ShareButton from "./ShareButton.astro";
import StockNote from "./StockNote.astro";
import VariantPicker from "./VariantPicker.astro";

interface Props {
	data: ProductPageData;
	storeHref?: string;
	cartHref?: string;
	addUrl?: string;
	contactHref?: string;
}
const {
	data,
	storeHref = "/store",
	cartHref = `${storeHref}/cart`,
	addUrl = "/api/bd/cart/add",
	contactHref = "/#contact",
} = Astro.props;

const { product, reviews, addons, related, moreReviewsHref } = data;
const view = toProductView(product);
const variantId = defaultVariant(view)?.id ?? "";
const price = priceFor(view, variantId, {});
const summary = productSummary(view, variantId, {});
const relatedCards: SavedProduct[] = related.map((rp) => ({
	id: rp.id,
	name: rp.name,
	image: rp.coverImageUrl,
	priceCents: rp.minPriceDollars != null ? Math.round(rp.minPriceDollars * 100) : null,
}));
// `<` written as <, so the JSON can't close the script tag early.
const json = JSON.stringify({ product }).replace(/</g, "\\u003c");
---

<ProductBreadcrumbs product={view} storeHref={storeHref} />

<div class="product-detail">
	<ProductGallery name={view.name} productId={view.id} sets={photoSets(view)} variantId={variantId} />

	<div class="product-detail__info bd-card">
		<ProductTitle product={view} reviews={reviews} />
		<bd-product-form data-add-url={addUrl} data-cart-href={cartHref}>
			<script is:inline type="application/json" set:html={json} />
			<ProductPrice price={price} />
			{view.description ? <p class="product-detail__desc">{view.description}</p> : null}
			<VariantPicker
				selected={variantId}
				showPrices={optionGroupsFor(view, variantId).length === 0}
				variants={view.variants}
			/>
			{
				allOptionGroups(view).map((group) => (
					<OptionPicker group={group} hidden={group.variantId !== null && group.variantId !== variantId} />
				))
			}
			<StockNote stock={price.stock} />

			<div class="buy">
				<QuantityStepper max={price.stock} />
				<AddToCartButton price={price} />
			</div>
			<CartNotice cartHref={cartHref} />

			<div class="product-detail__tools">
				<SaveButtons product={summary} />
				<ShareButton title={view.name} />
			</div>
			<ProductPolicies contactHref={contactHref} />
		</bd-product-form>
	</div>
</div>

<ProductSpecs features={view.features} specs={view.specs} />
<ProductAddons addUrl={addUrl} addons={addons} />
<ProductReviews moreHref={moreReviewsHref} reviews={reviews} />
<ProductRail products={relatedCards} storeHref={storeHref} title="You may also like" />
<RecentlyViewed product={summary} storeHref={storeHref} />
<CompareBar storeHref={storeHref} />
