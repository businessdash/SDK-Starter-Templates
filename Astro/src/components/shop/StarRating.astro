---
// [bd-file:store]
/** Five stars, filled to `rating` (halves shown). Same markup as the shop elements' stars. */
interface Props {
	rating: number;
}
const { rating } = Astro.props;
---

<span aria-label={`${rating.toFixed(1)} out of 5`} class="stars" role="img">
	{
		[1, 2, 3, 4, 5].map((i) => {
			const on = rating >= i;
			const half = !on && rating >= i - 0.5;
			return (
				<span class={`stars__star${on ? " stars__star--on" : ""}${half ? " stars__star--half" : ""}`}>★</span>
			);
		})
	}
</span>
