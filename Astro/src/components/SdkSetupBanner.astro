---
/**
 * Dismissable "not connected to BD yet" bar (fixed bottom).
 *
 * Rendered server-side ONLY when the site isn't wired up — i.e. when
 * PUBLIC_BD_SITE_ID or PUBLIC_BD_PK is missing. Astro only inlines
 * `PUBLIC_`-prefixed env into the client, so we also accept the `PUBLIC_` twins
 * (what the browser islands read) and the legacy plain `BD_SITE_ID`.
 *
 * The template renders local fallbacks when unconfigured, so this only tells you
 * how to connect it. Dismiss persists per-browser to localStorage; because the
 * markup + script are only emitted when unconfigured, a connected build ships
 * nothing at all.
 */
const siteId =
	import.meta.env.PUBLIC_BD_SITE_ID ??
	import.meta.env.PUBLIC_BD_SITE_ID ??
	import.meta.env.BD_SITE_ID;
const pk = import.meta.env.PUBLIC_BD_PK ?? import.meta.env.PUBLIC_BD_PK;
const configured = Boolean(siteId && pk);

const baseUrl =
	import.meta.env.PUBLIC_BD_PACKAGE_API_BASE_URL ??
	import.meta.env.PUBLIC_BD_PACKAGE_API_BASE_URL ??
	"https://www.biab.app";
const wizardUrl = `${String(baseUrl).replace(/\/+$/, "")}/login?returnTo=/dashboard/settings/web-content`;
---

{
	configured ? null : (
		<Fragment>
			<div
				id="bd-setup-banner"
				hidden
				style="position:fixed;inset-inline:0;bottom:0;z-index:9999;display:flex;flex-wrap:wrap;align-items:center;gap:0.75rem;padding:0.75rem 1rem;background:#08060d;color:#fff;border-top:1px solid var(--accent, #6033b8);font-size:0.875rem;"
			>
				<span style="flex:1 1 260px;min-width:0;">
					<strong style="color:#c4b5fd;">Not connected to BD yet.</strong> Add your
					<code>.env</code> to render live content — grab every variable (site ID,
					keys, revalidation secret) from the guided wizard.
				</span>
				<a
					href={wizardUrl}
					target="_blank"
					rel="noreferrer"
					style="flex-shrink:0;border-radius:0.5rem;border:1px solid var(--accent, #6033b8);background:rgba(96,51,184,0.18);padding:0.4rem 0.8rem;color:#ddd6fe;font-weight:600;text-decoration:none;"
				>
					Open setup wizard ↗
				</a>
				<button
					id="bd-setup-banner-dismiss"
					type="button"
					aria-label="Dismiss"
					style="flex-shrink:0;border:none;background:transparent;color:rgba(255,255,255,0.6);cursor:pointer;font-size:1.1rem;line-height:1;padding:0.25rem;"
				>
					✕
				</button>
			</div>
			<script is:inline>
				(function () {
					var KEY = "bd-sdk-setup-banner-dismissed";
					var el = document.getElementById("bd-setup-banner");
					if (!el) return;
					try {
						if (localStorage.getItem(KEY) === "1") {
							el.remove();
							return;
						}
					} catch (e) {}
					el.hidden = false;
					var btn = document.getElementById("bd-setup-banner-dismiss");
					if (btn)
						btn.addEventListener("click", function () {
							try {
								localStorage.setItem(KEY, "1");
							} catch (e) {}
							el.remove();
						});
				})();
			</script>
		</Fragment>
	)
}
