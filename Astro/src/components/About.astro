---
import { bd } from "../lib/bd";
// Newsletter signup wired to BD followers — the same shared component used in
// the footer. Vanilla `.astro` island by default; after `npx astro add react`,
// swap to the React drop-in: `import Subscribe from "./Subscribe.tsx"` + `client:load`.
import Subscribe from "./Subscribe.astro";

const fallback =
	"We're a small team that takes pride in being available. Real schedule, real reviews, real follow-up — no automated runaround. Book a slot below or send us a note and we'll get right back to you.";

let body = fallback;

if (bd) {
	try {
		const bundle = await bd.marketing.getPageBundle({
			pageKey: "home",
			locale: "en",
		});
		const raw = (bundle as { sections?: Record<string, unknown> })?.sections
			?.about;
		if (
			raw &&
			typeof raw === "object" &&
			"ok" in raw &&
			(raw as { ok: boolean }).ok
		) {
			const data = (raw as unknown as { data: Record<string, unknown> }).data;
			if (typeof data?.body === "string") body = data.body;
		}
	} catch {
		// stay on fallback
	}
}
---

<section class="bd-section bd-section--narrow" id="about">
	<div class="bd-section__lead">
		<span class="bd-section__eyebrow">About</span>
		<h2 class="bd-section__title">Built around how you actually work.</h2>
	</div>
	<p style="color: var(--text); font-size: 1.05rem; text-align: center;">
		{body}
	</p>
	<div class="about-subscribe">
		<Subscribe
			idPrefix="about"
			label="Get our newsletter"
			placeholder="you@example.com"
		/>
		{/* React drop-in (after `npx astro add react`): <Subscribe client:load idPrefix="about" label="Get our newsletter" /> */}
	</div>
</section>

<style>
	.about-subscribe {
		max-width: 28rem;
		margin: 2.25rem auto 0;
	}
</style>
