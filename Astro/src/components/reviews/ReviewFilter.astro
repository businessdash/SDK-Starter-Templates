---
/** All, then a link per platform (Google, Yelp…), when reviews come from more than one. */
import { type ReviewSource, sourceLabel } from "../../lib/bd-shop/reviews";

interface Props {
	sources: ReviewSource[];
	source: ReviewSource | null | undefined;
}
const { sources, source } = Astro.props;
---

{
	sources.length > 1 && (
		<nav aria-label="Platform">
			<ul class="reviews-filter">
				<li>
					<a href="/reviews" aria-current={source ? "false" : "true"}>
						All
					</a>
				</li>
				{sources.map((s) => (
					<li>
						<a href={`/reviews?source=${s}`} aria-current={source === s ? "true" : "false"}>
							{sourceLabel(s)}
						</a>
					</li>
				))}
			</ul>
		</nav>
	)
}
