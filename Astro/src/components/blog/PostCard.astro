---
// [bd-file:blog]
/** A post in the list: cover, Pinned, date and reading time, title, excerpt, author. `lead` draws it large. */
import type { BlogPublicPost } from "@businessdash/sdk/contracts";

import { formatPostDate, readingMinutes } from "../../lib/bd-shop/blog";

interface Props {
	post: BlogPublicPost;
	lead?: boolean;
}
const { post, lead = false } = Astro.props;
---

<li class={`bd-card post-card${lead ? " post-card--lead" : ""}`}>
	<a class="post-card__link" href={`/blog/${encodeURIComponent(post.slug)}`}>
		{
			post.imageUrl ? (
				<img alt="" class="post-card__img" loading="lazy" referrerpolicy="no-referrer" src={post.imageUrl} />
			) : null
		}
		<div class="post-card__body">
			<p class="post-card__meta">
				{post.isPinned ? <span class="bd-badge">Pinned</span> : null}
				<span>{formatPostDate(post.publishedAt)}</span>
				<span>· {readingMinutes(post.content || post.excerpt || "")} min read</span>
			</p>
			<h2>{post.title}</h2>
			{post.excerpt ? <p class="post-card__excerpt">{post.excerpt}</p> : null}
			{post.authorName ? <p class="post-card__author">{post.authorName}</p> : null}
		</div>
	</a>
</li>
