---
/**
 * Customer portal — "My account".
 *
 * Reads the `bd_session` cookie server-side (via `getCustomerSession`) and,
 * when signed in, shows the user + their work bundle (`getWork()` → jobs /
 * quotes / invoices) + a review-submission form. The form posts to
 * `/api/bd/portal/submit-review`, which calls the portal submit as the
 * signed-in customer.
 *
 * When signed out, shows the business's own sign-in screen (`<bd-sign-in>`:
 * name, logo and brand colours from BD; password, emailed codes, and
 * "Continue with Google / Apple / GitHub / Discord" — WorkOS underneath,
 * through /api/bd-auth). When BD auth is unconfigured, says so.
 */
import {
	getCustomerSession,
	getCustomerWork,
	isCustomerPortalConfigured,
} from "../lib/bd-portal";
// [bd:saas]
import { getCustomerSubscription } from "../lib/bd-portal";
// [/bd:saas]
import Layout from "../layouts/Layout.astro";

export const prerender = false;

const configured = isCustomerPortalConfigured();
const start =
	Astro.url.searchParams.get("start") === "create" ? "createAccount" : "signIn";
const session = configured ? await getCustomerSession(Astro.cookies) : null;
const work = session ? await getCustomerWork(Astro.cookies) : null;
// Where sign-in returns to: a path on this site, or the account page.
const rawNext = Astro.url.searchParams.get("next") ?? "";
const next =
	rawNext.startsWith("/") && !rawNext.startsWith("//") && !rawNext.startsWith("/\\")
		? rawNext
		: "/my-account";
// [bd:saas]
const plan = session
	? ((await getCustomerSubscription(Astro.cookies))?.subscription ?? null)
	: null;
// What just happened wins over the stored status, which lags until the
// payment provider confirms.
const planResult = Astro.url.searchParams.get("plan");
const cancelPending =
	planResult === "cancelled"
		? true
		: planResult === "resumed"
			? false
			: (plan?.cancelledButActive ?? false);
const accessUntil = plan?.expiresAt ?? null;
function formatDate(iso: string): string {
	return new Intl.DateTimeFormat(undefined, { dateStyle: "long" }).format(
		new Date(iso),
	);
}
// [/bd:saas]

const fullName = session
	? [session.user.firstName, session.user.lastName].filter(Boolean).join(" ") ||
		session.user.email ||
		"there"
	: null;

function money(n: number): string {
	return new Intl.NumberFormat(undefined, {
		style: "currency",
		currency: "USD",
	}).format(n);
}
---

<Layout
	title="My account — Your Business"
	description="Your jobs, quotes, invoices, and a place to leave a review."
	hideBanner
>
	<section class="bd-section bd-section--narrow" id="account">
		{
			!configured ? (
				<div class="bd-card account-card">
					<h2 class="bd-section__title">Accounts aren't connected yet</h2>
					<p>
						Set the BD keys to turn on sign-in. See <code>.env.example</code>.
					</p>
				</div>
			) : !session ? (
				<div class="bd-card account-card">
					<bd-sign-in
						start={start}
						redirect-to={next}
						tagline="See your jobs, quotes, and invoices — and leave a review."
					/>
				</div>
			) : (
				<>
					<div class="bd-section__lead" style="text-align: left;">
						<span class="bd-section__eyebrow">My account</span>
						<h2 class="bd-section__title">Welcome back, {fullName}.</h2>
						{session.user.email ? (
							<p class="bd-section__sub" style="margin: 0;">
								{session.user.email}
							</p>
						) : null}
					</div>

					{work?.unlinked ? (
						<div class="bd-empty">
							Your account isn't linked to a customer record yet. Once we add
							you, your jobs and invoices will appear here.
						</div>
					) : work ? (
						<div class="account-grid">
							<div class="bd-card account-stat">
								<span class="account-stat__n">{work.summary.openJobCount}</span>
								<span class="account-stat__l">Open jobs</span>
							</div>
							<div class="bd-card account-stat">
								<span class="account-stat__n">
									{work.summary.pendingQuoteCount}
								</span>
								<span class="account-stat__l">Pending quotes</span>
							</div>
							<div class="bd-card account-stat">
								<span class="account-stat__n">
									{work.summary.unpaidInvoiceCount}
								</span>
								<span class="account-stat__l">Unpaid invoices</span>
							</div>
							<div class="bd-card account-stat">
								<span class="account-stat__n">
									{money(work.summary.unpaidBalance)}
								</span>
								<span class="account-stat__l">Balance due</span>
							</div>
						</div>
					) : null}

					{work && work.jobs.length > 0 ? (
						<div class="account-section">
							<h3>Recent jobs</h3>
							<ul class="account-list">
								{work.jobs.slice(0, 5).map((j) => (
									<li class="bd-card account-row">
										<span>{j.name ?? "Job"}</span>
										<span class="bd-badge">{j.status}</span>
									</li>
								))}
							</ul>
						</div>
					) : null}

					{/* [bd:saas] */}
					<div class="account-section">
						<h3>Your plan</h3>
						<div class="bd-card account-card">
							{plan?.hasAccess ? (
								<>
									<strong>
										{plan.plan?.name ?? "Subscription"}{" "}
										<span class="bd-badge">
											{cancelPending ? "Cancelled" : "Active"}
										</span>
									</strong>
									{plan.type === "lifetime" ? (
										<p>Yours for good. Nothing renews.</p>
									) : (
										<>
											<p>
												{cancelPending
													? `It won't renew. You keep everything${accessUntil ? ` until ${formatDate(accessUntil)}` : ""}.`
													: accessUntil
														? `Renews ${formatDate(accessUntil)}.`
														: "Renews automatically."}
											</p>
											<form method="post" action="/api/bd/portal/plan">
												<input
													type="hidden"
													name="intent"
													value={cancelPending ? "resume" : "cancel"}
												/>
												<button class="bd-btn" type="submit">
													{cancelPending ? "Keep my plan" : "Cancel plan"}
												</button>
											</form>
										</>
									)}
								</>
							) : (
								<>
									<p>You don't have a plan yet.</p>
									<a class="bd-btn" href="/store/subscriptions">
										See plans
									</a>
								</>
							)}
							{planResult === "error" ? (
								<p class="account-error">
									We couldn't change your plan. Please try again.
								</p>
							) : null}
						</div>
					</div>
					{/* [/bd:saas] */}

					<div class="account-section">
						<h3>Leave a review</h3>
						<form class="bd-card account-card" data-review-form>
							<div>
								<label class="bd-label" for="review-rating">
									Rating
								</label>
								<select class="bd-select" id="review-rating" name="rating">
									<option value="5">★★★★★ — 5</option>
									<option value="4">★★★★ — 4</option>
									<option value="3">★★★ — 3</option>
									<option value="2">★★ — 2</option>
									<option value="1">★ — 1</option>
								</select>
							</div>
							<div>
								<label class="bd-label" for="review-title">
									Title (optional)
								</label>
								<input
									class="bd-input"
									id="review-title"
									name="title"
									placeholder="Great service"
								/>
							</div>
							<div>
								<label class="bd-label" for="review-body">
									Your review
								</label>
								<textarea
									class="bd-textarea"
									id="review-body"
									name="body"
									placeholder="Tell us how it went…"
									required
								/>
							</div>
							<button
								class="bd-btn"
								style="align-self: flex-start;"
								type="submit"
							>
								Submit review
							</button>
							<div data-review-error hidden></div>
						</form>
					</div>

					<p class="account-delete">
						<a href="/api/bd-auth/delete-account">Delete my account</a>
					</p>
				</>
			)
		}
	</section>
</Layout>

<style>
	.account-delete {
		margin-top: 2rem;
		font-size: 0.875rem;
	}
	.account-delete a {
		color: var(--text-muted);
	}
	.account-card {
		padding: 2rem;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		align-items: flex-start;
	}
	.account-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
		gap: 1rem;
		margin-bottom: 2rem;
	}
	.account-stat {
		padding: 1.25rem;
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}
	.account-stat__n {
		font-size: 1.6rem;
		font-weight: 800;
		color: var(--title);
	}
	.account-stat__l {
		font-size: 0.8rem;
		color: var(--text-muted);
	}
	.account-section {
		margin-top: 2rem;
	}
	.account-section h3 {
		margin-bottom: 1rem;
		font-size: 1.15rem;
	}
	.account-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}
	/* [bd:saas] */
	.account-error {
		color: var(--danger);
		font-size: 0.9rem;
	}
	/* [/bd:saas] */
	.account-row {
		padding: 0.85rem 1.25rem;
		display: flex;
		justify-content: space-between;
		align-items: center;
	}
	code {
		font-family: var(--mono);
		font-size: 0.85em;
		background: var(--accent-bg);
		color: var(--accent);
		padding: 0.1em 0.35em;
		border-radius: 0.35rem;
	}
</style>

<script>
	const form = document.querySelector<HTMLFormElement>("[data-review-form]");
	const errorBox = form?.querySelector<HTMLDivElement>("[data-review-error]");

	form?.addEventListener("submit", async (event) => {
		event.preventDefault();
		if (!form || !errorBox) return;
		errorBox.hidden = true;
		const submitBtn = form.querySelector<HTMLButtonElement>(
			"button[type=submit]",
		);
		if (submitBtn) {
			submitBtn.disabled = true;
			submitBtn.textContent = "Submitting…";
		}
		const fd = new FormData(form);
		try {
			const res = await fetch("/api/bd/portal/submit-review", {
				method: "POST",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify({
					rating: Number(fd.get("rating")),
					title: String(fd.get("title") ?? "") || undefined,
					body: String(fd.get("body") ?? ""),
				}),
			});
			if (!res.ok) throw new Error(await res.text());
			form.outerHTML = `
				<div class="bd-card account-card">
					<span class="bd-badge">Received</span>
					<h2 class="bd-section__title">Thanks for the review!</h2>
					<p>It'll appear once it's approved.</p>
				</div>`;
		} catch (err) {
			errorBox.hidden = false;
			errorBox.textContent =
				err instanceof Error ? err.message : "Couldn't submit your review.";
			errorBox.style.cssText =
				"color: var(--danger); background: var(--danger-bg); padding: 0.75rem 1rem; border-radius: 0.5rem; font-size: 0.9rem;";
			if (submitBtn) {
				submitBtn.disabled = false;
				submitBtn.textContent = "Submit review";
			}
		}
	});
</script>

<script>
	// Registers <bd-sign-in>: the screen mounts in the browser.
	import "@businessdash/sdk/element";
</script>
