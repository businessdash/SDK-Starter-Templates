---
/**
 * Astro's built-in 404 route, for static builds and for requests that never
 * reach the catch-all.
 *
 * Shares one body with `[...slug].astro` so the two cannot say different
 * things about the same situation.
 */
import Layout from "../layouts/Layout.astro";
import NotFound from "../components/NotFound.astro";
---

<Layout title="Page not found">
	<NotFound />
</Layout>
