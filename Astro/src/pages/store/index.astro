---
// [bd-file:store]
/**
 * The product list. Server-renders the catalog via
 * `storefront.listProductsWithMeta()`, which returns enriched cards (price,
 * compare-at price, rating, badges) plus the facet data (`categoryCounts`,
 * `priceRange`) behind the sidebar. Every filter is in the URL (?q,
 * ?category, ?min, ?max, ?rating, ?sort): the facets are links and the
 * search, price and sort are plain GET forms, so the page works without JS,
 * a filtered list can be shared and the back button steps through filters.
 * The page is laid out from the shop's parts (`src/components/shop/`): the
 * filters, the grid of product cards (each saves to the wishlist or the
 * comparison) and the compare bar.
 *
 * Suspension-aware: if the org's billing has lapsed / service is suspended,
 * the SDK throws and we return a 503 "site unavailable" document. Unconfigured
 * BD shows a friendly "store not connected" empty state instead.
 */
import "../../styles/bd-shop.css";

import CategoryFilter from "../../components/shop/CategoryFilter.astro";
import ClearFilters from "../../components/shop/ClearFilters.astro";
import CompareBar from "../../components/shop/CompareBar.astro";
import type { Card } from "../../components/shop/ProductCard.astro";
import ProductGrid from "../../components/shop/ProductGrid.astro";
import PriceFilter from "../../components/shop/PriceFilter.astro";
import RatingFilter from "../../components/shop/RatingFilter.astro";
import SortSelect from "../../components/shop/SortSelect.astro";
import StoreSearch from "../../components/shop/StoreSearch.astro";
import { hasFilters as filtersSet, sortOf } from "../../components/shop/store-filters";
import StoreNav from "../../components/StoreNav.astro";
import Layout from "../../layouts/Layout.astro";
import { bd } from "../../lib/bd";
import {
	isStoreConfigured,
	listStoreCategories,
	listStoreProductsWithMeta,
} from "../../lib/bd-store";
import { isSuspensionError, suspendedResponse } from "../../lib/bd-suspension";

export const prerender = false;

function parseCents(raw: string | null): number | undefined {
	if (!raw) return undefined;
	const dollars = Number.parseFloat(raw);
	return Number.isFinite(dollars) ? Math.round(dollars * 100) : undefined;
}

// ── Read filters from the URL ────────────────────────────────────────────────
const params = Astro.url.searchParams;
const search = params.get("q")?.trim() || undefined;
const categoryId = params.get("category") || undefined;
const sort = sortOf(params);
const minPriceCents = parseCents(params.get("min"));
const maxPriceCents = parseCents(params.get("max"));
const ratingRaw = Number.parseInt(params.get("rating") ?? "", 10);
const minRating = ratingRaw >= 1 && ratingRaw <= 5 ? ratingRaw : undefined;
const hasFilters = filtersSet(params);

let products: Card[] = [];
let categories: { id: string; name: string; count: number }[] = [];
let priceRange: { minDollars: number; maxDollars: number } | null = null;
let loadError = false;
let suspended = false;

if (bd) {
	try {
		const [meta, cats] = await Promise.all([
			listStoreProductsWithMeta({
				limit: 48,
				...(search ? { search } : {}),
				...(categoryId ? { categoryId } : {}),
				...(minPriceCents != null ? { minPriceCents } : {}),
				...(maxPriceCents != null ? { maxPriceCents } : {}),
				...(minRating ? { minRating } : {}),
				sort,
			}),
			listStoreCategories(),
		]);
		if (meta === null) {
			loadError = true;
		} else {
			products = meta.items as Card[];
			priceRange = meta.priceRange;
			const counts = new Map(meta.categoryCounts.map((c) => [c.categoryId, c.count]));
			categories = (cats?.items ?? []).map((c) => ({
				id: c.id,
				name: c.name,
				count: counts.get(c.id) ?? 0,
			}));
		}
	} catch (err) {
		if (isSuspensionError(err)) suspended = true;
		else loadError = true;
	}
}

if (suspended) return suspendedResponse();
---

<Layout
	title="Store — Your Business"
	description="Browse products and check out securely. Catalog + cart powered by the BD SDK."
>
	<StoreNav />
	<div class="bd-page">
		<div class="bd-section__lead">
			<span class="bd-section__eyebrow">Shop</span>
			<h1 class="bd-section__title">Products</h1>
			<p class="bd-section__sub">
				Filter, sort, and open a product to choose its options and add it to your cart.
			</p>
		</div>

		{
			!isStoreConfigured() ? (
				<div class="bd-empty">
					Store isn't connected. Add your BD keys (see <code>.env.example</code>) and products from
					the dashboard will appear here.
				</div>
			) : loadError ? (
				<div class="bd-empty">Couldn't load the catalog right now.</div>
			) : (
				<div class="store-layout">
					<aside class="store-sidebar">
						<StoreSearch />
						<CategoryFilter categories={categories} />
						<PriceFilter range={priceRange} />
						<RatingFilter />
						<ClearFilters />
					</aside>

					<div class="store-results">
						<div class="store-results__bar">
							<p class="bd-loading">
								{`${products.length} ${products.length === 1 ? "product" : "products"}`}
							</p>
							<SortSelect />
						</div>

						{products.length === 0 ? (
							<div class="bd-empty">
								{hasFilters
									? "No products match these filters. Try clearing a filter or broadening your search."
									: "No live products yet. Add and publish products in the BD dashboard and they'll appear here."}
							</div>
						) : (
							<ProductGrid products={products} />
						)}
						<CompareBar />
					</div>
				</div>
			)
		}
	</div>
</Layout>

<script>
	import "../../lib/bd-shop/shop-elements";
</script>
