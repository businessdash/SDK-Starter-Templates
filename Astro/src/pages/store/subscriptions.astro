---
// [bd-file:subscriptions]
/**
 * Subscriptions list. Server-renders recurring offerings via
 * `subscriptions.list()`. Each card shows the price + billing interval.
 * "Subscribe" posts to `/api/bd/subscriptions/checkout`, which hands a
 * signed-in customer to Stripe; a visitor is offered sign-in first.
 *
 * Suspension-aware (503) and unconfigured-safe.
 */
import { bd } from "../../lib/bd";
import { isStoreConfigured } from "../../lib/bd-store";
import { getCustomerSession } from "../../lib/bd-portal";
import { isSuspensionError, suspendedResponse } from "../../lib/bd-suspension";
import Layout from "../../layouts/Layout.astro";
import StoreNav from "../../components/StoreNav.astro";

export const prerender = false;

type Offering = {
	id: string;
	name: string;
	description: string | null;
	imageUrl: string | null;
	amountCents: number;
	interval: "day" | "week" | "month" | "year";
};

let offerings: Offering[] = [];
let loadError = false;
let suspended = false;

if (bd) {
	try {
		const res = await bd.subscriptions.list();
		offerings = (res?.items ?? []) as Offering[];
	} catch (err) {
		if (isSuspensionError(err)) suspended = true;
		else loadError = true;
	}
}

if (suspended) return suspendedResponse();

const signedIn = (await getCustomerSession(Astro.cookies)) !== null;
const subscribed = Astro.url.searchParams.has("session_id");
const checkoutFailed = Astro.url.searchParams.get("error") === "checkout";

function price(o: Offering): string {
	const amount = new Intl.NumberFormat(undefined, {
		style: "currency",
		currency: "USD",
	}).format(o.amountCents / 100);
	return `${amount} / ${o.interval}`;
}
---

<Layout
	title="Plans & subscriptions — Your Business"
	description="Recurring plans and memberships, billed securely through Stripe."
>
	<StoreNav />
	<section class="bd-section" id="subscriptions">
		<div class="bd-section__lead">
			<span class="bd-section__eyebrow">Memberships</span>
			<h2 class="bd-section__title">Plans & subscriptions</h2>
			<p class="bd-section__sub">
				Recurring offerings from BD. Pick a plan and we'll set up billing.
			</p>
		</div>

		{
			subscribed ? (
				<div class="bd-empty">
					Thanks for subscribing. Your plan is in <a href="/my-account">your account</a>.
				</div>
			) : null
		}
		{
			checkoutFailed ? (
				<div class="sub-error">Couldn't start checkout. Please try again.</div>
			) : null
		}

		{
			!isStoreConfigured() ? (
				<div class="bd-empty">Store isn't connected.</div>
			) : loadError ? (
				<div class="bd-empty">Couldn't load plans right now.</div>
			) : offerings.length === 0 ? (
				<div class="bd-empty">
					No subscription plans yet. Create one in BD at Dashboard → Products →
					Subscriptions.
				</div>
			) : (
				<div class="bd-grid-3">
					{offerings.map((o) => (
						<article class="bd-card sub-card">
							{o.imageUrl ? (
								<img class="sub-card__img" src={o.imageUrl} alt={o.name} />
							) : null}
							<h3>{o.name}</h3>
							<div class="sub-card__price">{price(o)}</div>
							{o.description ? (
								<p class="sub-card__desc">{o.description}</p>
							) : null}
							{signedIn ? (
								<form method="post" action="/api/bd/subscriptions/checkout">
									<input type="hidden" name="planId" value={o.id} />
									<button class="bd-btn" type="submit">
										Subscribe
									</button>
								</form>
							) : (
								<a class="bd-btn" href="/my-account?next=/store/subscriptions">
									Sign in to subscribe
								</a>
							)}
						</article>
					))}
				</div>
			)
		}
	</section>
</Layout>

<style>
	.sub-card {
		padding: 1.5rem;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		align-items: flex-start;
	}
	.sub-card__img {
		width: 100%;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		border-radius: 0.6rem;
	}
	.sub-card__price {
		color: var(--accent);
		font-weight: 700;
		font-size: 1.1rem;
	}
	.sub-error {
		color: var(--danger);
		background: var(--danger-bg);
		padding: 0.75rem 1rem;
		border-radius: 0.5rem;
		margin-bottom: 1.5rem;
	}
	.sub-card__desc {
		color: var(--text-muted);
		font-size: 0.92rem;
	}
</style>
