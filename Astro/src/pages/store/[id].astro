---
/**
 * Product detail. Server-renders one product via `storefront.getProduct(id)`,
 * with an inline add-to-cart island that posts to `/api/biab/cart/add`
 * (mints the visitor cookie, returns the new snapshot) then sends the shopper
 * to the cart.
 *
 * Suspension-aware (503) and unconfigured-safe.
 */
import { biab } from "../../lib/biab";
import { isStoreConfigured } from "../../lib/biab-store";
import { isSuspensionError, suspendedResponse } from "../../lib/biab-suspension";
import Layout from "../../layouts/Layout.astro";

export const prerender = false;

const { id } = Astro.params;

type Variant = Record<string, unknown> & { id?: string; name?: string };
type ProductDetail = {
	id: string;
	name: string;
	images?: string[] | null;
	variants?: Variant[];
	[key: string]: unknown;
};

let product: ProductDetail | null = null;
let notFound = false;
let suspended = false;

if (biab && id) {
	try {
		product = (await biab.storefront.getProduct(id)) as ProductDetail;
	} catch (err) {
		if (isSuspensionError(err)) suspended = true;
		else notFound = true;
	}
}

if (suspended) return suspendedResponse();

function money(cents: number): string {
	return new Intl.NumberFormat(undefined, {
		style: "currency",
		currency: "USD",
	}).format(cents / 100);
}

function variantLabel(v: Variant): string {
	const name =
		(typeof v.name === "string" && v.name) ||
		(typeof v.title === "string" && v.title) ||
		"Option";
	const cents = typeof v.priceCents === "number" ? v.priceCents : null;
	return cents ? `${name} — ${money(cents)}` : name;
}

const description =
	(typeof product?.description === "string" && product.description) || null;
const heroImage = product?.images?.[0] ?? null;
const variants = product?.variants ?? [];
---

<Layout
	title={product ? `${product.name} — Store` : "Product — Store"}
	description={description ?? "Product detail"}
>
	<section class="biab-section biab-section--narrow" id="product">
		<a class="product-back" href="/store">← Back to store</a>

		{
			!isStoreConfigured() ? (
				<div class="biab-empty">Store isn't connected.</div>
			) : notFound || !product ? (
				<div class="biab-empty">
					That product isn't available. <a href="/store">Browse the store →</a>
				</div>
			) : (
				<div class="product-detail" data-product data-product-id={product.id}>
					{heroImage ? (
						<img class="product-detail__img" src={heroImage} alt={product.name} />
					) : (
						<div class="product-detail__img product-detail__img--empty" />
					)}
					<div class="product-detail__info">
						<h1 class="biab-section__title">{product.name}</h1>
						{description ? <p>{description}</p> : null}

						{variants.length > 0 ? (
							<div>
								<label class="biab-label" for="variant">
									Choose an option
								</label>
								<select class="biab-select" id="variant" data-variant>
									{variants.map((v) => (
										<option value={String(v.id ?? "")}>
											{variantLabel(v)}
										</option>
									))}
								</select>
							</div>
						) : null}

						<div class="product-detail__qty">
							<label class="biab-label" for="qty">
								Quantity
							</label>
							<input
								class="biab-input"
								id="qty"
								type="number"
								min="1"
								value="1"
								data-qty
								style="max-width: 6rem;"
							/>
						</div>

						<button class="biab-btn" data-add-to-cart type="button">
							Add to cart
						</button>
						<div data-add-error hidden></div>
					</div>
				</div>
			)
		}
	</section>
</Layout>

<style>
	.product-back {
		display: inline-block;
		margin-bottom: 1.5rem;
		font-size: 0.9rem;
		color: var(--text-muted);
	}
	.product-detail {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2rem;
		align-items: start;
	}
	.product-detail__img {
		width: 100%;
		aspect-ratio: 1 / 1;
		object-fit: cover;
		border-radius: 1rem;
	}
	.product-detail__img--empty {
		background: var(--bg-soft);
	}
	.product-detail__info {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		align-items: flex-start;
	}
	.product-detail__info p {
		color: var(--text-muted);
	}
	@media (max-width: 640px) {
		.product-detail {
			grid-template-columns: 1fr;
		}
	}
</style>

<script>
	const root = document.querySelector<HTMLDivElement>("[data-product]");
	if (root) {
		const addBtn = root.querySelector<HTMLButtonElement>("[data-add-to-cart]");
		const variantSel = root.querySelector<HTMLSelectElement>("[data-variant]");
		const qtyInput = root.querySelector<HTMLInputElement>("[data-qty]");
		const errorBox = root.querySelector<HTMLDivElement>("[data-add-error]");

		addBtn?.addEventListener("click", async () => {
			if (!addBtn) return;
			const productId = root.dataset.productId;
			if (!productId) return;
			const variantId = variantSel?.value || undefined;
			const quantity = Math.max(1, Number(qtyInput?.value ?? "1") || 1);
			addBtn.disabled = true;
			addBtn.textContent = "Adding…";
			if (errorBox) errorBox.hidden = true;
			try {
				const res = await fetch("/api/biab/cart/add", {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify({ productId, variantId, quantity }),
				});
				if (!res.ok) throw new Error(await res.text());
				window.location.href = "/store/cart";
			} catch (err) {
				if (errorBox) {
					errorBox.hidden = false;
					errorBox.textContent =
						err instanceof Error ? err.message : "Couldn't add to cart.";
					errorBox.style.cssText =
						"color: var(--danger); background: var(--danger-bg); padding: 0.75rem 1rem; border-radius: 0.5rem; font-size: 0.9rem;";
				}
				addBtn.disabled = false;
				addBtn.textContent = "Add to cart";
			}
		});
	}
</script>
