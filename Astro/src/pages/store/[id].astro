---
// [bd-file:store]
/**
 * One product: photos that follow the chosen option, option and size
 * buttons, the price for what's chosen, add to cart, save and compare,
 * share, details, add-ons, reviews, related products and what was viewed
 * before. The server loads it all here and `<bd-product>` (see
 * `src/lib/bd-shop/shop-elements.ts`) draws the page from that data; adding
 * to the cart posts to `/api/bd/cart/add`. More reviews: ?reviews=20.
 *
 * Suspension-aware (503) and unconfigured-safe.
 */
import "../../styles/bd-shop.css";

import StoreNav from "../../components/StoreNav.astro";
import Layout from "../../layouts/Layout.astro";
import { bd } from "../../lib/bd";
import type { ProductPageData } from "../../lib/bd-shop/shop-elements";
import {
	getStoreProductAddons,
	getStoreProductReviews,
	getStoreRelatedProducts,
	isStoreConfigured,
} from "../../lib/bd-store";
import { isSuspensionError, suspendedResponse } from "../../lib/bd-suspension";

export const prerender = false;

/** Reviews shown at first, and how many more each "Show more" adds. */
const REVIEWS_PAGE = 10;

const id = Astro.params.id ?? "";
const reviewsRaw = Number.parseInt(Astro.url.searchParams.get("reviews") ?? "", 10);
const reviewLimit = Math.min(
	100,
	Number.isFinite(reviewsRaw) && reviewsRaw > REVIEWS_PAGE ? reviewsRaw : REVIEWS_PAGE,
);

let data: ProductPageData | null = null;
let suspended = false;

if (bd && id) {
	try {
		const product = await bd.storefront.getProduct(id);
		const [reviews, addons, related] = await Promise.all([
			getStoreProductReviews(id, { limit: reviewLimit }),
			getStoreProductAddons(id),
			getStoreRelatedProducts(id),
		]);
		data = {
			product,
			reviews,
			addons: addons ?? [],
			related: related ?? [],
			moreReviewsHref:
				reviews && reviews.totalCount > reviews.items.length
					? `/store/${encodeURIComponent(id)}?reviews=${reviewLimit + REVIEWS_PAGE}#reviews`
					: null,
		};
	} catch (err) {
		if (isSuspensionError(err)) suspended = true;
	}
}

if (suspended) return suspendedResponse();
if (isStoreConfigured() && !data) Astro.response.status = 404;

const product = data?.product;
const description = typeof product?.description === "string" && product.description ? product.description : null;
const heroImage = product?.images?.[0] ?? null;
// `<` written as <, so the JSON can't close the script tag early.
const json = data ? JSON.stringify(data).replace(/</g, "\\u003c") : "";
---

<Layout
	title={product ? `${product.name} — Store` : "Product — Store"}
	description={description ?? "Product detail"}
	ogImage={heroImage}
>
	<StoreNav />
	<div class="bd-page">
		{
			!isStoreConfigured() ? (
				<div class="bd-empty">Store isn't connected.</div>
			) : !data || !product ? (
				<div class="bd-empty">
					That product isn't available. <a href="/store">Browse the store</a>
				</div>
			) : (
				<bd-product data-add-url="/api/bd/cart/add" data-contact-href="/#contact">
					<script is:inline type="application/json" set:html={json} />
					<noscript>
						<h1>{product.name}</h1>
						{description ? <p>{description}</p> : null}
						<p>Turn on JavaScript to choose options and add this to your cart.</p>
					</noscript>
				</bd-product>
			)
		}
	</div>
</Layout>

<script>
	import "../../lib/bd-shop/shop-elements";
</script>
