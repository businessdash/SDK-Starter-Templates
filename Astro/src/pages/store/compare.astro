---
// [bd-file:store]
/**
 * Up to four products side by side: price, rating, category, options and
 * every spec any of them lists. The products come from ?ids=a,b, so a
 * comparison can be shared; opened without ids, `<bd-compare>` (see
 * `src/lib/bd-shop/shop-elements.ts`) moves this browser's picks into the URL.
 */
import "../../styles/bd-shop.css";

import StoreNav from "../../components/StoreNav.astro";
import Layout from "../../layouts/Layout.astro";
import { bd } from "../../lib/bd";
import type { CompareColumn } from "../../lib/bd-shop/shop-elements";
import { getStoreProductReviews } from "../../lib/bd-store";

export const prerender = false;

const ids = (Astro.url.searchParams.get("ids") ?? "")
	.split(",")
	.map((part) => part.trim())
	.filter(Boolean)
	.slice(0, 4);

const columns: CompareColumn[] = [];
if (bd) {
	const client = bd;
	const loaded = await Promise.all(
		ids.map(async (id): Promise<CompareColumn | null> => {
			try {
				const [product, reviews] = await Promise.all([
					client.storefront.getProduct(id),
					getStoreProductReviews(id, { limit: 1 }),
				]);
				return {
					product,
					rating: reviews && reviews.totalCount > 0 ? { avg: reviews.avgRating, count: reviews.totalCount } : null,
				};
			} catch {
				return null;
			}
		}),
	);
	for (const column of loaded) if (column) columns.push(column);
}

// `<` written as <, so the JSON can't close the script tag early.
const json = JSON.stringify({ ids, columns }).replace(/</g, "\\u003c");
---

<Layout title="Compare — Store" description="Products side by side.">
	<StoreNav />
	<div class="bd-page">
		<div class="bd-section__lead">
			<span class="bd-section__eyebrow">Shop</span>
			<h1 class="bd-section__title">Compare</h1>
			<p class="bd-section__sub">Up to four products side by side.</p>
		</div>
		<bd-compare>
			<script is:inline type="application/json" set:html={json} />
		</bd-compare>
	</div>
</Layout>

<script>
	import "../../lib/bd-shop/shop-elements";
</script>
