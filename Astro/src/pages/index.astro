---
/**
 * Generic business site composed of server-rendered sections.
 *
 * Each section component reads from `bd.*` directly. The static-data
 * sections (Hero, About, Services, Gallery, Blog, Reviews) are pure
 * server-render. Booking and ContactForm ship a tiny client island that talks
 * to Astro endpoints under `/api/bd/*`.
 *
 * The shared `Layout` adds the news banner, JSON-LD, header (with cart + auth
 * state), and footer. Same canonical section set as the React-Bun and
 * Vanilla-JS starters — only the framework + render strategy changes.
 */
import About from "../components/About.astro";
import Blog from "../components/Blog.astro";
import Booking from "../components/Booking.astro";
import Gallery from "../components/Gallery.astro";
import Hero from "../components/Hero.astro";
import Reviews from "../components/Reviews.astro";
import Services from "../components/Services.astro";
import Layout from "../layouts/Layout.astro";

// Schema-driven contact form. The `<BdForm>` drop-in ships as a React island
// (`ContactForm.tsx`); enable React with `npx astro add react`, then it renders
// every field, validates, and submits through `/api/bd/forms/[slug]`.
//
// The base starter ships without React, so the page uses the vanilla
// `ContactForm.astro` island by default. To switch to the React drop-in:
//   1. `npx astro add react`
//   2. swap the two imports / tags below (comment one pair, uncomment the other).
import ContactForm from "../components/ContactForm.astro";
// import ContactForm from "../components/ContactForm.tsx";

export const prerender = false;
---

<Layout>
	<Hero />
	<About />
	<Services />
	<Gallery />
	<Booking />
	<Reviews />
	<Blog />
	<ContactForm />
	{/* React drop-in (after `npx astro add react`): <ContactForm client:load /> */}
</Layout>
