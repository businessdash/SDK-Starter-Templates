---
// [bd-file:blog]
/**
 * One post. Its HTML is rebuilt from an allowlist here on the server
 * (`safePostHtml`) and only that reaches the page. Likes and comments are
 * for signed-in customers: `<bd-post-like>` and `<bd-post-comments>` (see
 * `src/lib/bd-shop/blog-elements.ts`) post to /api/bd/blog/:slug/{like,comment};
 * signed out, they lead to sign-in and back here. The page is laid out from
 * the blog's parts (`src/components/blog/`).
 */
import "../../styles/bd-blog.css";

import Comments from "../../components/blog/Comments.astro";
import LikeButton from "../../components/blog/LikeButton.astro";
import MembersOnly from "../../components/blog/MembersOnly.astro";
import PostBody from "../../components/blog/PostBody.astro";
import PostCta from "../../components/blog/PostCta.astro";
import PostMeta from "../../components/blog/PostMeta.astro";
import PostTags from "../../components/blog/PostTags.astro";
import Layout from "../../layouts/Layout.astro";
import { getBlogLikes, getBlogPost, listBlogComments } from "../../lib/bd-blog";
import { getCustomerSession } from "../../lib/bd-portal";
import { readingMinutes, safePostHtml } from "../../lib/bd-shop/blog";

export const prerender = false;

const slug = Astro.params.slug ?? "";
const result = await getBlogPost(slug);
if (!result) Astro.response.status = 404;

const session = result ? await getCustomerSession(Astro.cookies).catch(() => null) : null;
const [likes, comments] = result
	? await Promise.all([getBlogLikes(slug, session?.token ?? null), listBlogComments(slug)])
	: [null, { items: [] }];

const post = result?.post ?? null;
const paywalled = result?.access === "paywall";
const signedIn = session !== null;
const here = `/blog/${encodeURIComponent(slug)}`;
const signInHref = `/my-account?next=${encodeURIComponent(here)}`;
const api = `/api/bd/blog/${encodeURIComponent(slug)}`;
---

<Layout
	title={post ? `${post.title} — Blog` : "Post not found"}
	description={post?.excerpt ?? "A post from the blog."}
	ogImage={post?.imageUrl ?? null}
>
	<div class="bd-page">
		{
			!post ? (
				<div class="bd-empty">
					That post isn't available. <a href="/blog">See all posts</a>
				</div>
			) : (
				<>
					<article class="post">
						<a class="post__back" href="/blog">
							← All posts
						</a>
						<header class="post__head">
							<h1>{post.title}</h1>
							<PostMeta
								authorAvatarUrl={post.authorAvatarUrl}
								authorName={post.authorName}
								minutes={readingMinutes(post.content)}
								publishedAt={post.publishedAt}
							/>
						</header>
						{post.imageUrl ? <img alt="" class="post__cover" referrerpolicy="no-referrer" src={post.imageUrl} /> : null}
						{paywalled ? <MembersOnly signInHref={signInHref} /> : <PostBody html={safePostHtml(post.content)} />}
						{post.ctaHref && post.ctaLabel ? (
							<PostCta description={post.ctaDescription} href={post.ctaHref} label={post.ctaLabel} />
						) : null}
						<PostTags tags={post.tags} />
						<LikeButton
							likeUrl={`${api}/like`}
							likes={likes ?? { liked: false, likesCount: post.likes }}
							signInHref={signInHref}
							signedIn={signedIn}
						/>
					</article>
					<Comments
						commentUrl={`${api}/comment`}
						comments={comments.items}
						signInHref={signInHref}
						signedIn={signedIn}
					/>
				</>
			)
		}
	</div>
</Layout>

<script>
	import "../../lib/bd-shop/blog-elements";
</script>
