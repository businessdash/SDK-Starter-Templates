# BD SDK credentials. Copy to .env (or .env.local) and fill in.

# ═══════════════════════════════════════════════════════════════════
# BD Web Content SDK
#
# Easiest path: open the guided wizard in your BD dashboard —
#   Settings → Web Content SDK   (https://www.biab.app/login?returnTo=/dashboard/settings/web-content)
# It creates every value below and hands you a copy-paste block.
#
# Each variable maps to a spot in the dashboard:
#   VITE_BD_SITE_ID        → Site Builder ▸ Developer ▸ "Site ID"
#   BD_API_KEY             → Site Builder ▸ Developer ▸ "Secret keys"
#   VITE_BD_PK             → Site Builder ▸ Developer ▸ "Publishable tokens"
#   BD_REVALIDATION_SECRET → the wizard, or Settings ▸ Integrations
#
# Remix note: Remix runs on Vite, so browser-exposed vars use the VITE_ prefix
# (read via import.meta.env). Server-only secrets carry no prefix (read via
# process.env) and never reach the client bundle. Existing setups on the older
# server-only names (BD_SITE_ID / BD_PACKAGE_API_BASE_URL) keep working —
# the server lib falls back to them.
# ═══════════════════════════════════════════════════════════════════

# ── Non-secret + browser-safe (the browser needs these) ─────────────
# Where BD is hosted (defaults to production when unset).
VITE_BD_PACKAGE_API_BASE_URL=https://www.biab.app

# The site UUID this app renders.
VITE_BD_SITE_ID=

# Publishable token (`pk_…`): origin-locked, rate-limited, and scoped to
# `followers:self`, so it is safe in the browser. Powers the newsletter /
# followers signup (footer + about). Leave PK + SITE_ID empty and the Subscribe
# component falls back to a "coming soon" placeholder (the app still runs).
VITE_BD_PK=

# ── Server-only secrets — NEVER prefix these with VITE_ ─────────────
# Secret API key (`sk_…`) for authenticated server-side reads.
BD_API_KEY=

# HMAC secret for the BD → this-app revalidate webhook (`whsec_…`). Lets BD
# tell the site to refresh the instant content changes (no polling). Paste the
# value from /dashboard/settings/integrations. Required for the
# /api/bd/revalidate resource route to verify events.
BD_REVALIDATION_SECRET=

# Optional. Analytics-only public key for the client analytics beacon. Defaults
# to BD_API_KEY. Mint a separate narrower key and set it here if you'd rather
# not reuse the bearer for browser analytics.
BD_PUBLIC_KEY=

# Public, fully-qualified URL of your auth handler's /callback route.
# Required for sign-in / sign-up / customer portal. Register it as a
# redirect URI in your BD site's WorkOS settings.
#   Prod: https://www.your-site.com/api/bd-auth/callback
#   Dev:  http://localhost:3000/api/bd-auth/callback
BD_AUTH_CALLBACK_URL=

# Optional. Your public site origin, used as the `siteUrl` in the
# server-rendered JSON-LD (localBusiness + website). Defaults to
# https://example.com when unset.
BD_SITE_URL=https://example.com
