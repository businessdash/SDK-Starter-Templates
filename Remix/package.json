{
  "name": "bd-remix",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "check": "tsc --noEmit",
    "sync-schema": "tsx node_modules/@businessdash/sdk/dist/cli.js sync-schema --config bd.config.ts",
    "sync-content": "tsx node_modules/@businessdash/sdk/dist/cli.js sync-content --config bd.config.ts",
    "print-schema": "tsx node_modules/@businessdash/sdk/dist/cli.js print-schema --config bd.config.ts",
    "sync-data-model": "tsx node_modules/@businessdash/sdk/dist/cli.js sync-data-model --config bd.data-model.config.ts",
    "print-data-model": "tsx node_modules/@businessdash/sdk/dist/cli.js print-data-model --config bd.data-model.config.ts"
  },
  "dependencies": {
    "@businessdash/sdk": "^0.9.90",
    "@react-router/node": "^7.18.0",
    "@react-router/serve": "^7.18.0",
    "isbot": "^5.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.18.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@react-router/dev": "^7.18.0",
    "@react-router/fs-routes": "^7.18.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.22.3",
    "typescript": "^5.5.0",
    "vite": "^6.4.2",
    "vite-tsconfig-paths": "^5.1.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.25.0",
      "estree-util-value-to-estree": "^3.3.3",
      "tar": "^7.5.8",
      "turbo-stream": "^3.0.0",
      "undici": "^6.27.0",
      "vite": "^6.4.3"
    }
  }
}
