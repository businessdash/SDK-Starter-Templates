{
  "name": "bd-laravel-starter",
  "private": true,
  "type": "module",
  "description": "Node is NOT a runtime dependency of this starter \u2014 the app is pure PHP. The SDK is here only for its CLI, which resolves the TypeScript config files below and computes the canonical checksum the platform verifies. Porting that checksum to PHP would mean matching the canonicalisation byte for byte; running the real CLI keeps one source of truth instead.",
  "scripts": {
    "sync-schema": "tsx node_modules/@businessdash/sdk/dist/cli.js sync-schema --config bd.config.ts",
    "sync-content": "tsx node_modules/@businessdash/sdk/dist/cli.js sync-content --config bd.config.ts",
    "print-schema": "tsx node_modules/@businessdash/sdk/dist/cli.js print-schema --config bd.config.ts",
    "sync-data-model": "tsx node_modules/@businessdash/sdk/dist/cli.js sync-data-model --config bd.data-model.config.ts",
    "print-data-model": "tsx node_modules/@businessdash/sdk/dist/cli.js print-data-model --config bd.data-model.config.ts",
    "view-data-model": "tsx node_modules/@businessdash/sdk/dist/cli.js view-data-model",
    "seed": "tsx node_modules/@businessdash/sdk/dist/cli.js sync-records --records-dir ./bd-records"
  },
  "devDependencies": {
    "@businessdash/sdk": "^0.9.90",
    "tsx": "^4.22.4",
    "zod": "^3.25.76"
  }
}
