# ═══════════════════════════════════════════════════════════════════
# BD Web Content SDK — Laravel starter
#
# Easiest path: the guided wizard in your BD dashboard —
#   Settings → Web Content SDK
#   https://www.biab.app/login?returnTo=/dashboard/settings/web-content
# It creates every value below and hands you a copy-paste block.
#
# Where each one lives in the dashboard:
#   BD_SITE_ID             → Site Builder ▸ Developer ▸ "Site ID"
#   BD_API_KEY             → Site Builder ▸ Developer ▸ "Secret keys"
#   BD_PK                  → Site Builder ▸ Developer ▸ "Publishable tokens"
#   BD_REVALIDATION_SECRET → the wizard, or Settings ▸ Integrations
#
# Laravel never exposes .env to the browser, so unlike the Vite/Next
# starters there is no PUBLIC_/NEXT_PUBLIC_ split here. Everything below
# is server-side; the browser only sees what a Blade template prints.
# ═══════════════════════════════════════════════════════════════════

APP_NAME="BD Laravel Starter"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Tagged cache invalidation needs a tag-capable store. `file` and
# `database` do NOT support tags — the app falls back to flushing
# everything, which works but is blunt. Use redis or memcached in
# production so the publish webhook drops only what changed.
CACHE_STORE=redis
SESSION_DRIVER=cookie

# ── BD ────────────────────────────────────────────────────────────

# Where BD is hosted (host root — the client appends /api/package/v1).
BD_HOST=https://www.biab.app

# The site UUID this app renders.
BD_SITE_ID=

# Secret API key (`sk_…`) for authenticated server-side reads.
# NEVER print this into a Blade template.
BD_API_KEY=

# Publishable token (`pk_…`): origin-locked, rate-limited, browser-safe.
# Optional here — this starter renders server-side and the bundled
# <bd-form> island goes through the app's own /api/bd/forms proxy,
# so no key reaches the browser. Set it only if you add an island that
# calls BD directly.
BD_PK=

# HMAC secret for the BD → this-app revalidate webhook (`whsec_…`).
# Lets BD tell the site to drop cache tags the moment content is
# published. Required for POST /api/bd/revalidate to verify events.
BD_REVALIDATION_SECRET=

# Public, fully-qualified URL of this app's auth callback. Required for
# sign-in / sign-up / customer portal. Register it as a redirect URI in
# your BD site's auth settings.
#   Prod: https://www.your-site.com/api/bd-auth/callback
#   Dev:  http://localhost:8000/api/bd-auth/callback
BD_AUTH_CALLBACK_URL=http://localhost:8000/api/bd-auth/callback

# Origin sent on every server-to-server call. The platform gates some
# routes on the requesting host, and a server has no browser Origin, so
# this must be the site's real public origin. Defaults to APP_URL.
BD_SITE_ORIGIN=http://localhost:8000

# Seconds to cache marketing/catalog reads. The revalidate webhook busts
# these by tag on publish, so this is a floor, not a staleness budget.
BD_CACHE_TTL=300
