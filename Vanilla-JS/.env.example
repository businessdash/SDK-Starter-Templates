# ═══════════════════════════════════════════════════════════════════
# BD Web Content SDK
#
# Easiest path: open the guided wizard in your BD dashboard —
#   Settings → Web Content SDK   (https://www.biab.app/login?returnTo=/dashboard/settings/web-content)
# It creates every value below and hands you a copy-paste block.
#
# Each variable maps to a spot in the dashboard:
#   BD_SITE_ID  → Site Builder ▸ Developer ▸ "Site ID"
#   BD_API_KEY              → Site Builder ▸ Developer ▸ "Secret keys"
#   BD_PK       → Site Builder ▸ Developer ▸ "Publishable tokens"
#   BD_REVALIDATION_SECRET  → the wizard, or Settings ▸ Integrations
#
# The Bun server (`server.ts`) reads these and injects only the browser-safe
# ones into each page as `window.__BD_PUBLIC__`. Copy to .env.local.
# ═══════════════════════════════════════════════════════════════════

# ── Non-secret + browser-safe (the browser needs these) ─────────────
# Where BD is hosted (defaults to production when unset).
BD_PACKAGE_API_BASE_URL=https://www.biab.app

# The site UUID this app renders.
BD_SITE_ID=

# Publishable token (`pk_…`): origin-locked, rate-limited, browser-safe. The
# server injects it (with SITE_ID + base URL) as `window.__BD_PUBLIC__`, so
# the newsletter subscribe section + analytics call BD directly. When it +
# SITE_ID are unset, those components degrade to placeholders (the app still runs).
BD_PK=

# ── Server-only secrets — never expose to the browser ──────
# Secret API key (`sk_…`) for authenticated server-side reads. The Bun server
# holds it; the browser only ever talks to same-origin /api/bd/* endpoints.
BD_API_KEY=

# HMAC secret for the BD → this-app revalidate webhook (`whsec_…`). Lets BD
# tell the site to refresh the instant content changes (no polling). Required
# for /api/bd/revalidate to verify incoming events.
BD_REVALIDATION_SECRET=

# Public, fully-qualified URL of your auth handler's /callback route.
# Required for sign-in / sign-up / customer portal. Register it as a
# redirect URI in your BD site's WorkOS settings.
#   Prod: https://www.your-site.com/api/bd-auth/callback
#   Dev:  http://localhost:3000/api/bd-auth/callback
BD_AUTH_CALLBACK_URL=

# Optional: HTTP port for the Bun server. Defaults to 3000.
# PORT=3000
