# ═══════════════════════════════════════════════════════════════════
# BIAB Web Content SDK
#
# Easiest path: open the guided wizard in your BIAB dashboard —
#   Settings → Web Content SDK   (https://www.biab.app/login?returnTo=/dashboard/settings/web-content)
# It creates every value below and hands you a copy-paste block.
#
# Each variable maps to a spot in the dashboard:
#   BIAB_SITE_ID  → Site Builder ▸ Developer ▸ "Site ID"
#   BIAB_API_KEY              → Site Builder ▸ Developer ▸ "Secret keys"
#   BIAB_PK       → Site Builder ▸ Developer ▸ "Publishable tokens"
#   BIAB_REVALIDATION_SECRET  → the wizard, or Settings ▸ Integrations
#
# Copy this file to .env.local and fill in the values.
# ═══════════════════════════════════════════════════════════════════

# ── Non-secret + browser-safe (the browser needs these) ─────────────
# Where BIAB is hosted (defaults to production when unset).
BIAB_PACKAGE_API_BASE_URL=https://www.biab.app

# The site UUID this app renders.
BIAB_SITE_ID=

# Publishable token (`pk_…`): origin-locked, rate-limited, browser-safe.
# Optional in this starter — HTMX renders entirely server-side and never ships
# the SDK to the browser, so the newsletter subscribe joins followers through
# the server-side BIAB_API_KEY below. Set it only if you add a browser island.
BIAB_PK=

# ── Server-only secrets — never expose to the browser ──────
# Secret API key (`sk_…`) for authenticated server-side reads. HTMX never sends
# it to the browser — the whole app renders server-side.
BIAB_API_KEY=

# HMAC secret for the BIAB → this-app revalidate webhook (`whsec_…`). Lets BIAB
# tell the site to refresh the instant content changes (no polling). Required
# for /api/biab/revalidate to verify incoming events.
BIAB_REVALIDATION_SECRET=

# Public, fully-qualified URL of your auth handler's /callback route.
# Required for sign-in / sign-up / customer portal. Register it as a
# redirect URI in your BIAB site's WorkOS settings.
#   Prod: https://www.your-site.com/api/biab-auth/callback
#   Dev:  http://localhost:3000/api/biab-auth/callback
BIAB_AUTH_CALLBACK_URL=

# Optional: HTTP port for the Bun server. Defaults to 3000.
PORT=3000
