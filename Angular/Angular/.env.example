# BD Web Content SDK — SERVER credentials. Copy this to ".env" and fill in.
# This file is read ONLY by the Node SSR server (process.env); the browser
# bundle never sees it. The BROWSER-safe values (publishable token + site id +
# base URL) live in src/environments/environment.ts instead — see the bottom.
#
# ═══════════════════════════════════════════════════════════════════
# Easiest path: open the guided wizard in your BD dashboard —
#   Settings → Web Content SDK   (https://www.biab.app/login?returnTo=/dashboard/settings/web-content)
# It creates every value below and hands you a copy-paste block.
#
# Each variable maps to a spot in the dashboard:
#   BD_SITE_ID  → Site Builder ▸ Developer ▸ "Site ID"
#   BD_API_KEY              → Site Builder ▸ Developer ▸ "Secret keys"
#   BD_PK       → Site Builder ▸ Developer ▸ "Publishable tokens"
#                               (browser-safe — set as `bdPk` in
#                                src/environments/environment.ts, NOT here)
#   BD_REVALIDATION_SECRET  → the wizard, or Settings ▸ Integrations
# ═══════════════════════════════════════════════════════════════════

# ── Non-secret site config (read server-side) ───────────────────────
# The site UUID this app renders.
BD_SITE_ID=

# Where BD is hosted (defaults to production when unset).
BD_PACKAGE_API_BASE_URL=https://www.biab.app

# ── Server-only secrets — never expose to the browser ──
# Secret API key (`sk_…`), the per-site package key from Site Builder ▸
# Developer ▸ "Secret keys" (NOT your admin token). This template keeps it on
# the Node SSR server: the browser talks to /api/bd/* endpoints, never to
# BD directly. Do not ship it in the browser bundle.
BD_API_KEY=

# HMAC secret for the BD → this-app revalidate webhook (`whsec_…`). Required
# for the /api/bd/revalidate endpoint to verify events.
BD_REVALIDATION_SECRET=

# Optional: a SEPARATE, explicitly-public analytics ingest key. Only set this
# if you want client-side pageview analytics — it's the ONLY key the server
# exposes to the browser (via /api/bd/public-config). Leave blank to keep
# analytics off. The main BD_API_KEY above is never sent to the browser.
BD_PUBLIC_ANALYTICS_KEY=

# Public, fully-qualified URL of your auth handler's /callback route.
# Required for sign-in / sign-up / customer portal. Register it as a
# redirect URI in your BD site's WorkOS settings.
#   Prod: https://www.your-site.com/api/bd-auth/callback
#   Dev:  http://localhost:4200/api/bd-auth/callback
BD_AUTH_CALLBACK_URL=

# ── Legacy aliases (still honored, no need to set if you use the above) ──
# Older setups used the plain server names; they still work as fallbacks:
#   BD_SITE_ID / BD_PACKAGE_API_BASE_URL

# ── Browser-safe config lives in src/environments/environment.ts ────
# The publishable token (`pk_…`) and its site id / base url ship in the browser
# bundle, so they are set there (NOT in this .env), as:
#   bdPk      → BD_PK       (publishable token, pk_…)
#   bdSiteId  → BD_SITE_ID  (same UUID as above)
#   bdBaseUrl → BD_PACKAGE_API_BASE_URL (same host as above)
