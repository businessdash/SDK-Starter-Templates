# ═══════════════════════════════════════════════════════════════════
# BIAB Web Content SDK — Phoenix starter
#
# Easiest path: the guided wizard in your BIAB dashboard —
#   Settings → Web Content SDK
#   https://www.biab.app/login?returnTo=/dashboard/settings/web-content
#
# Where each one lives in the dashboard:
#   BIAB_SITE_ID             → Site Builder ▸ Developer ▸ "Site ID"
#   BIAB_API_KEY             → Site Builder ▸ Developer ▸ "Secret keys"
#   BIAB_PK                  → Site Builder ▸ Developer ▸ "Publishable tokens"
#   BIAB_REVALIDATION_SECRET → the wizard, or Settings ▸ Integrations
#
# Elixir has no bundler inlining values into a browser bundle, so unlike the
# Vite/Next starters there is no PUBLIC_ prefix convention here. Nothing below
# reaches the browser unless a template prints it.
# ═══════════════════════════════════════════════════════════════════

# Where BIAB is hosted (host root — the client appends /api/package/v1).
BIAB_HOST=https://www.biab.app

# The site UUID this app renders.
BIAB_SITE_ID=

# Secret API key (`sk_…`) for authenticated server-side reads.
BIAB_API_KEY=

# Publishable token (`pk_…`): origin-locked, rate-limited, browser-safe.
# Optional here — this starter renders server-side and the <biab-form> island
# goes through the app's own /api/biab/forms proxy, so no key reaches the
# browser. Set it only if you add an island that calls BIAB directly.
BIAB_PK=

# HMAC secret for the BIAB → this-app revalidate webhook (`whsec_…`).
# Required for POST /api/biab/revalidate to verify events.
BIAB_REVALIDATION_SECRET=

# Public, fully-qualified URL of this app's auth callback. Required for
# sign-in / sign-up / customer portal. Register it as a redirect URI on the
# BIAB site.
#   Prod: https://www.your-site.com/api/biab-auth/callback
#   Dev:  http://localhost:4000/api/biab-auth/callback
BIAB_AUTH_CALLBACK_URL=http://localhost:4000/api/biab-auth/callback

# Origin sent on every server-to-server call. A server has no browser Origin
# but the platform gates on it, so this must be the site's real public origin.
BIAB_SITE_ORIGIN=http://localhost:4000

# Seconds to cache marketing/catalog reads.
BIAB_CACHE_TTL=300

PORT=4000
