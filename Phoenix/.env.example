# ═══════════════════════════════════════════════════════════════════
# BD Web Content SDK — Phoenix starter
#
# Easiest path: the guided wizard in your BD dashboard —
#   Settings → Web Content SDK
#   https://www.biab.app/login?returnTo=/dashboard/settings/web-content
#
# Where each one lives in the dashboard:
#   BD_SITE_ID             → Site Builder ▸ Developer ▸ "Site ID"
#   BD_API_KEY             → Site Builder ▸ Developer ▸ "Secret keys"
#   BD_PK                  → Site Builder ▸ Developer ▸ "Publishable tokens"
#   BD_REVALIDATION_SECRET → the wizard, or Settings ▸ Integrations
#
# Elixir has no bundler inlining values into a browser bundle, so unlike the
# Vite/Next starters there is no PUBLIC_ prefix convention here. Nothing below
# reaches the browser unless a template prints it.
# ═══════════════════════════════════════════════════════════════════

# Where BD is hosted (host root — the client appends /api/package/v1).
BD_HOST=https://www.biab.app

# The site UUID this app renders.
BD_SITE_ID=

# Secret API key (`sk_…`) for authenticated server-side reads.
BD_API_KEY=

# Publishable token (`pk_…`): origin-locked, rate-limited, browser-safe.
# Optional here — this starter renders server-side and the <bd-form> island
# goes through the app's own /api/bd/forms proxy, so no key reaches the
# browser. Set it only if you add an island that calls BD directly.
BD_PK=

# HMAC secret for the BD → this-app revalidate webhook (`whsec_…`).
# Required for POST /api/bd/revalidate to verify events.
BD_REVALIDATION_SECRET=

# Public, fully-qualified URL of this app's auth callback. Required for
# sign-in / sign-up / customer portal. Register it as a redirect URI on the
# BD site.
#   Prod: https://www.your-site.com/api/bd-auth/callback
#   Dev:  http://localhost:4000/api/bd-auth/callback
BD_AUTH_CALLBACK_URL=http://localhost:4000/api/bd-auth/callback

# Origin sent on every server-to-server call. A server has no browser Origin
# but the platform gates on it, so this must be the site's real public origin.
BD_SITE_ORIGIN=http://localhost:4000

# Seconds to cache marketing/catalog reads.
BD_CACHE_TTL=300

PORT=4000
