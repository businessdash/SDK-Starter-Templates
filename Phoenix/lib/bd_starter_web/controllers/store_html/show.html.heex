<%!--
  One product. The controller reads the product, its reviews, add-ons and
  related products; product_detail/1 (BdStarterWeb.ProductComponents) lays
  the page out from the shop's parts, one function component each: option
  photos, option and size buttons, the price for what's chosen, add to cart
  (POST /api/bd/cart/add), save, compare, share, add-ons, reviews, related
  and recently viewed.
--%>
<div :if={not @configured} class="bd-empty">
  The store isn't connected yet. Set <code>BD_SITE_ID</code>
  and <code>BD_API_KEY</code>
  in <code>.env</code>.
</div>
<div :if={@configured and @unavailable} class="bd-empty">
  The store is temporarily unavailable. Please check back soon.
</div>
<div :if={@configured and not @unavailable and is_nil(@data)} class="bd-empty">
  That product isn't available. <a href={~p"/store"}>Browse the store</a>
</div>
<.product_detail
  :if={@data}
  add_url={~p"/api/bd/cart/add"}
  cart_href={~p"/cart"}
  data={@data}
  store_href={~p"/store"}
/>
