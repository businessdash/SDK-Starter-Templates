<%!--
  The product list: search, category, price and rating filters with a sort.
  Each card saves to the wishlist or the comparison (<bd-save-buttons>), and
  <bd-compare-bar> shows the picks. BdStarterWeb.StoreController.index/2.
--%>
<div class="bd-section__lead">
  <span class="bd-section__eyebrow">Shop</span>
  <h1 class="bd-section__title">Products</h1>
  <p class="bd-section__sub">
    Filter, sort, and open a product to choose its options and add it to your cart.
  </p>
</div>

<div :if={not @configured} class="bd-empty">
  The store isn't connected yet. Set <code>BD_SITE_ID</code>
  and <code>BD_API_KEY</code>
  in <code>.env</code>.
</div>
<div :if={@configured and is_nil(@listing)} class="bd-empty">
  The store is temporarily unavailable. Please check back soon.
</div>

<div :if={@configured and @listing} class="store-layout">
  <aside aria-label="Product filters" class="store-sidebar">
    <search>
      <form action={~p"/store"} method="get">
        <label class="bd-label" for="store-search">Search</label>
        <input
          autocomplete="off"
          class="bd-input"
          id="store-search"
          name="q"
          placeholder="Search products…"
          type="search"
          value={@query["q"]}
        />
        <input :for={{name, value} <- keep(@query, ["q"])} type="hidden" name={name} value={value} />
      </form>
    </search>

    <div :if={@categories != []} class="store-facet">
      <p class="store-facet__title">Category</p>
      <ul class="store-facet__list">
        <li>
          <a
            class={["store-facet__item", is_nil(@filters.category_id) && "store-facet__item--active"]}
            href={href_with(@query, category: nil)}
          >
            All products
          </a>
        </li>
        <li :for={category <- @categories}>
          <% active = @filters.category_id == category["id"] %>
          <a
            class={["store-facet__item store-facet__item--row", active && "store-facet__item--active"]}
            href={href_with(@query, category: if(active, do: nil, else: category["id"]))}
          >
            <span>{category["name"]}</span>
            <span class="store-facet__count">{Map.get(@counts, category["id"], 0)}</span>
          </a>
        </li>
      </ul>
    </div>

    <form action={~p"/store"} class="store-facet" method="get">
      <p class="store-facet__title">Price</p>
      <div class="store-price">
        <input
          aria-label="Lowest price"
          class="bd-input"
          inputmode="decimal"
          name="priceMin"
          placeholder={if @price_range, do: "$#{floor(@price_range["minDollars"] || 0)}", else: "Min"}
          value={@query["priceMin"]}
        />
        <span aria-hidden="true" class="store-price__sep">–</span>
        <input
          aria-label="Highest price"
          class="bd-input"
          inputmode="decimal"
          name="priceMax"
          placeholder={if @price_range, do: "$#{ceil(@price_range["maxDollars"] || 0)}", else: "Max"}
          value={@query["priceMax"]}
        />
      </div>
      <input
        :for={{name, value} <- keep(@query, ["priceMin", "priceMax"])}
        type="hidden"
        name={name}
        value={value}
      />
      <button class="bd-btn bd-btn--ghost store-price__apply" type="submit">Apply</button>
    </form>

    <div class="store-facet">
      <p class="store-facet__title">Rating</p>
      <ul class="store-facet__list">
        <li :for={stars <- [4, 3, 2]}>
          <% active = @filters.min_rating == stars %>
          <a
            class={["store-facet__item store-facet__rating", active && "store-facet__item--active"]}
            href={href_with(@query, rating: if(active, do: nil, else: stars))}
          >
            <.stars rating={stars} /><span class="store-facet__count">&amp; up</span>
          </a>
        </li>
      </ul>
    </div>

    <a :if={@has_filters} class="store-clear" href={~p"/store"}>Clear all filters</a>
  </aside>

  <div class="store-results">
    <div class="store-results__bar">
      <p class="bd-loading">
        {length(@products)} {if length(@products) == 1, do: "product", else: "products"}
      </p>
      <form action={~p"/store"} class="store-sort" method="get">
        <label for="store-sort">Sort</label>
        <select class="bd-select" id="store-sort" name="sort" onchange="this.form.requestSubmit()">
          <option
            :for={{value, label} <- BdStarterWeb.StoreController.sorts()}
            value={value}
            selected={@filters.sort == value}
          >
            {label}
          </option>
        </select>
        <input :for={{name, value} <- keep(@query, ["sort"])} type="hidden" name={name} value={value} />
        <noscript><button class="bd-btn bd-btn--ghost" type="submit">Sort</button></noscript>
      </form>
    </div>

    <div :if={@products == []} class="bd-empty">
      <%= if @has_filters do %>
        No products match these filters. Try clearing a filter or broadening your search.
      <% else %>
        No live products yet. Add and publish products in the BD dashboard and they'll appear here.
      <% end %>
    </div>

    <div :if={@products != []} class="bd-grid-3">
      <div :for={product <- @products} class="bd-card product-card">
        <% name = product["name"] || "Untitled" %>
        <% price = product["cheapestPriceCents"] %>
        <a class="product-card__link" href={~p"/store/#{product["id"]}"}>
          <div class="product-card__media">
            <img
              :if={product["coverImage"]}
              alt={name}
              class="product-card__img"
              loading="lazy"
              referrerpolicy="no-referrer"
              src={product["coverImage"]}
            />
            <div :if={!product["coverImage"]} class="product-card__noimg">No image</div>
            <div class="product-card__badges">
              <span :if={product["isBestSeller"]} class="bd-badge">Best seller</span>
              <span :if={product["isNew"]} class="bd-badge">New</span>
              <span :if={product["isOnSale"]} class="bd-badge product-card__badge--sale">Sale</span>
            </div>
          </div>
          <div class="product-card__body">
            <h3>{name}</h3>
            <div :if={(product["reviewCount"] || 0) > 0} class="product-card__rating">
              <.stars rating={product["avgRating"] || 0} />
              <span class="product-card__count">({product["reviewCount"]})</span>
            </div>
            <div class="product-card__price">
              <span class="product-card__amount">
                <%= if price do %>
                  {if product["hasMultipleVariants"], do: "From "}{cents(price)}
                <% else %>
                  View details
                <% end %>
              </span>
              <span
                :if={product["isOnSale"] && product["comparePriceCents"]}
                class="product-card__compare"
              >
                {cents(product["comparePriceCents"])}
              </span>
            </div>
            <span :if={product["isLowStock"]} class="product-card__lowstock">Low stock</span>
          </div>
        </a>
        <div class="product-card__save">
          <bd-save-buttons compact data-product={save_data(product)}></bd-save-buttons>
        </div>
      </div>
    </div>
    <bd-compare-bar></bd-compare-bar>
  </div>
</div>
