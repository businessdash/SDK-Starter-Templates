<%!--
  The product list: search, category, price and rating filters with a sort.
  It's laid out from the shop's parts (BdStarterWeb.StoreComponents), one
  function component each: the filters, the sort, and a product card per
  product, which saves to the wishlist or the comparison (<bd-save-buttons>);
  compare_bar/1 shows the picks. BdStarterWeb.StoreController.index/2.
--%>
<div class="bd-section__lead">
  <span class="bd-section__eyebrow">Shop</span>
  <h1 class="bd-section__title">Products</h1>
  <p class="bd-section__sub">
    Filter, sort, and open a product to choose its options and add it to your cart.
  </p>
</div>

<div :if={not @configured} class="bd-empty">
  The store isn't connected yet. Set <code>BD_SITE_ID</code>
  and <code>BD_API_KEY</code>
  in <code>.env</code>.
</div>
<div :if={@configured and is_nil(@listing)} class="bd-empty">
  The store is temporarily unavailable. Please check back soon.
</div>

<div :if={@configured and @listing} class="store-layout">
  <aside aria-label="Product filters" class="store-sidebar">
    <.store_search query={@query} />
    <.category_filter categories={@categories} counts={@counts} query={@query} selected={@filters.category_id} />
    <.price_filter query={@query} range={@price_range} />
    <.rating_filter query={@query} selected={@filters.min_rating} />
    <.clear_filters :if={@has_filters} />
  </aside>

  <div class="store-results">
    <div class="store-results__bar">
      <p class="bd-loading">
        {length(@products)} {if length(@products) == 1, do: "product", else: "products"}
      </p>
      <.sort_select query={@query} selected={@filters.sort} />
    </div>

    <div :if={@products == []} class="bd-empty">
      <%= if @has_filters do %>
        No products match these filters. Try clearing a filter or broadening your search.
      <% else %>
        No live products yet. Add and publish products in the BD dashboard and they'll appear here.
      <% end %>
    </div>

    <.product_grid :if={@products != []} products={@products} />
    <.compare_bar store_href={~p"/store"} />
  </div>
</div>
