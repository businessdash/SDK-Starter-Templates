<%!--
  The cart: plain forms (CartController), laid out from the shop's parts
  (BdStarterWeb.StoreComponents): a line per item, the subtotal, a coupon box
  and Checkout.
--%>
<h1>Cart</h1>

<% items = (@cart && @cart["items"]) || [] %>

<p :if={items == []} class="muted">
  Your cart is empty. <a href={~p"/store"}>Browse the store</a>.
</p>

<div :if={items != []}>
  <ul class="cart-lines">
    <.cart_line :for={item <- items} item={item} />
  </ul>

  <.cart_summary cart={@cart} />
  <.coupon_form />
  <.cart_actions />
</div>
