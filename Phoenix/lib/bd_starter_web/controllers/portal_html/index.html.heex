<h1>My account</h1>

<p>Signed in as {(@user && @user["email"]) || "a customer"}.</p>
<a href="/api/bd-auth/sign-out">Sign out</a>

<section>
  <h2>Your work</h2>
  <% jobs = (@work && @work["jobs"]) || [] %>
  <ul :if={jobs != []}>
    <li :for={job <- jobs}>{job["name"]} — {job["status"]}</li>
  </ul>
  <p :if={jobs == []} class="muted">Nothing here yet.</p>
</section>

<section>
  <h2>Leave a review</h2>
  <form method="post" action={~p"/my-account/review"}>
    <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
    <label>
      Rating
      <select name="rating">
        <option :for={n <- 5..1//-1} value={n}>{n}</option>
      </select>
    </label>
    <textarea name="body" required placeholder="How did we do?"></textarea>
    <button type="submit">Submit</button>
  </form>
</section>
