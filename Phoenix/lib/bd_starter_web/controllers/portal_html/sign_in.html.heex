<h1>My account</h1>

<%!--
  The business's own sign-in screen (its name, logo and brand colours from
  BD): password, emailed codes, and "Continue with Google / Apple / GitHub /
  Discord" — a LiveView (BdStarterWeb.SignInLive) that runs each step through
  BD, WorkOS underneath, and sets the httpOnly session cookie.
--%>
<link rel="stylesheet" href={~p"/bd-sign-in.css"} />
<div class="signin-card">
  {live_render(@conn, BdStarterWeb.SignInLive, session: %{"start" => @start, "problem" => @problem, "next" => @next})}
</div>
<script>
  // After LiveView's own focus restore, which runs once the update is applied.
  window.addEventListener("phx:bd-sign-in-focus", (e) =>
    requestAnimationFrame(() => document.getElementById(e.detail.id)?.focus())
  );
</script>
