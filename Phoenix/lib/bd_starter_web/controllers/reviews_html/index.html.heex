<%!--
  The business's reviews (ReviewsController). The rating and its bars come
  from the marketing bundle; the platform filter and "Show more" are plain
  links. Writing one is <bd-review-writer> (priv/static/shop/reviews-elements.js):
  signed out, it's a link to sign in. It's laid out from the reviews' parts
  (BdStarterWeb.ReviewComponents): the rating summary, the platform filter and
  a card per review.
--%>
<div class="bd-section__lead">
  <span class="bd-section__eyebrow">Reviews</span>
  <h1 class="bd-section__title">What customers say</h1>
</div>

<div :if={not @configured} class="bd-empty">
  Reviews aren't connected yet. Set BD_API_KEY and BD_SITE_ID, and your rating and reviews appear here.
</div>

<%= if @configured do %>
  <.rating_summary signed_in={@signed_in} summary={@summary} />
  <.review_filter source={@source} sources={@sources} />

  <p :if={@reviews == []} class="reviews-empty">{empty_message(@source)}</p>

  <ul :if={@reviews != []} class="review-wall">
    <.review_card :for={{review, i} <- Enum.with_index(@reviews)} index={i} review={review} />
  </ul>

  <p :if={@more_href} class="reviews-more">
    <a class="bd-btn bd-btn--ghost" href={@more_href}>Show more reviews</a>
  </p>
<% end %>
