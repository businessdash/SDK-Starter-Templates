<%!--
  One post. Its HTML was rebuilt from an allowlist (BdStarterWeb.PostHtml), so
  the raw HTML never reaches the page. The like button and comments are
  <bd-post-like> and <bd-post-comments> (priv/static/shop/blog-elements.js);
  signed out, they lead to sign-in and back to the post. It's laid out from
  the blog's parts (BdStarterWeb.BlogComponents): meta, body (or members
  only), call to action, tags, like button and comments.
--%>
<div :if={is_nil(@post)} class="bd-empty">
  That post isn't available. <a href={~p"/blog"}>See all posts</a>
</div>

<%= if @post do %>
  <article class="post">
    <a class="post__back" href={~p"/blog"}>← All posts</a>
    <header class="post__head">
      <h1>{@post["title"]}</h1>
      <.post_meta minutes={@minutes} post={@post} />
    </header>
    <img
      :if={@post["imageUrl"]}
      alt=""
      class="post__cover"
      referrerpolicy="no-referrer"
      src={@post["imageUrl"]}
    />
    <.members_only :if={@paywalled} sign_in_href={@sign_in_href} />
    <%!-- Safe: PostHtml.safe/1 rebuilt this from an allowlist. --%>
    <.post_body :if={not @paywalled} html={@html} />
    <.post_cta post={@post} />
    <.post_tags tags={@post["tags"] || []} />
    <.like_button
      like_url={~p"/blog/#{@post["slug"]}/like"}
      likes={@likes}
      sign_in_href={@sign_in_href}
    />
  </article>
  <.comments
    comment_url={~p"/blog/#{@post["slug"]}/comment"}
    comments={@comments}
    sign_in_href={@sign_in_href}
  />
<% end %>
