<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="BD Phoenix starter">{assigns[:page_title]}</.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <%!--
      Forms and quizzes are drawn on this server (BdStarterWeb.FormLive and
      QuizLive) in the SDK's bd-* classes: the SDK's own stylesheet, then
      priv/static/forms.css on top. Pinned to an exact version on purpose: a
      CDN link has no lockfile, so @latest would roll this page forward on
      somebody else's release.
    --%>
    <link rel="stylesheet" href="https://esm.sh/@businessdash/sdk@0.9.97/bd-forms.css" />
    <link phx-track-static rel="stylesheet" href={~p"/forms.css"} />
    <%!-- The store's, the blog's and the reviews' pages: their styles, and the elements that draw them. --%>
    <link
      :if={assigns[:store_nav] || assigns[:blog] || assigns[:reviews_page]}
      rel="stylesheet"
      href={~p"/bd-pages.css"}
    />
    <link :if={assigns[:store_nav]} rel="stylesheet" href={~p"/bd-shop.css"} />
    <link :if={assigns[:blog]} rel="stylesheet" href={~p"/bd-blog.css"} />
    <link :if={assigns[:reviews_page]} rel="stylesheet" href={~p"/bd-reviews.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/app.js"}>
    </script>
  </head>
  <body>
    {@inner_content}
    <script :if={assigns[:store_nav]} type="module" src={~p"/shop/shop-elements.js"}>
    </script>
    <script :if={assigns[:blog] == :post} type="module" src={~p"/shop/blog-elements.js"}>
    </script>
    <script :if={assigns[:reviews_page]} type="module" src={~p"/shop/reviews-elements.js"}>
    </script>
  </body>
</html>
