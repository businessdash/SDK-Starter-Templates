<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="BD Phoenix starter">{assigns[:page_title]}</.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <%!--
      Forms and quizzes are drawn on this server (BdStarterWeb.FormLive and
      QuizLive) in the SDK's bd-* classes: the SDK's own stylesheet, then
      priv/static/forms.css on top. Pinned to an exact version on purpose: a
      CDN link has no lockfile, so @latest would roll this page forward on
      somebody else's release.
    --%>
    <link rel="stylesheet" href="https://esm.sh/@businessdash/sdk@0.9.96/bd-forms.css" />
    <link phx-track-static rel="stylesheet" href={~p"/forms.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/app.js"}>
    </script>
  </head>
  <body>
    {@inner_content}
  </body>
</html>
