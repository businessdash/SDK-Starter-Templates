# Since the ".env.local" file is gitignored, copy this ".env.example" to
# ".env.local" and fill in real values. Both the Bun proxy (server.ts) and the
# Vite browser bundle read it. Keep this file up-to-date as you add variables.
#
# This file IS committed to version control, so never put real secrets in it.

# ═══════════════════════════════════════════════════════════════════
# BD Web Content SDK
#
# Easiest path: open the guided wizard in your BD dashboard —
#   Settings → Web Content SDK   (https://www.biab.app/login?returnTo=/dashboard/settings/web-content)
# It creates every value below and hands you a copy-paste block.
#
# Each variable maps to a spot in the dashboard:
#   VITE_BD_SITE_ID  → Site Builder ▸ Developer ▸ "Site ID"
#   BD_API_KEY              → Site Builder ▸ Developer ▸ "Secret keys"
#   VITE_BD_PK       → Site Builder ▸ Developer ▸ "Publishable tokens"
#   BD_REVALIDATION_SECRET  → the wizard, or Settings ▸ Integrations
# ═══════════════════════════════════════════════════════════════════

# ── Non-secret + browser-safe (the browser needs these) ─────────────
# Where BD is hosted (defaults to production when unset).
VITE_BD_PACKAGE_API_BASE_URL=https://www.biab.app

# The site UUID this app renders.
VITE_BD_SITE_ID=

# Publishable token (`pk_…`): origin-locked, rate-limited, browser-safe. Powers
# the newsletter signup and client-side analytics. When it + SITE_ID are unset,
# those components degrade to placeholders (the app still runs).
VITE_BD_PK=

# ── Server-only secrets — NEVER prefix these with VITE_ ──────
# Secret API key (`sk_…`). The Bun proxy (server.ts) holds it and forwards
# /api/bd/* to BD — it never reaches the browser bundle.
BD_API_KEY=

# HMAC secret for the BD → this-app revalidate webhook (`whsec_…`). Lets BD
# tell the site to refresh the instant content changes (no polling).
BD_REVALIDATION_SECRET=

# Public, fully-qualified URL of your auth handler's /callback route.
# Required for sign-in / sign-up / customer portal. Register it as a
# redirect URI in your BD site's WorkOS settings.
#   Prod: https://www.your-site.com/api/bd-auth/callback
#   Dev:  http://localhost:3000/api/bd-auth/callback
BD_AUTH_CALLBACK_URL=

# Optional: port for the Bun proxy. Defaults to 3000. Vite serves the SPA on
# 5173 and forwards /api/bd/* here (see vite.config.ts).
# PORT=3000

# ── Legacy aliases (still honored, no need to set if you use the above) ──
# Older setups used the plain server names + VITE_-prefixed browser twins.
# They still work as fallbacks, so existing .env files keep running:
#   BD_SITE_ID / BD_PACKAGE_API_BASE_URL              (server)
#   VITE_BD_SITE_ID / VITE_BD_PK /
#   VITE_BD_PUBLIC_KEY / VITE_BD_PACKAGE_API_BASE_URL (browser)
