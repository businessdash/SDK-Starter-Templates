{
  "name": "react-bun",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n vite,server -c blue,magenta \"vite\" \"bun --watch run server.ts\"",
    "dev:vite": "vite",
    "dev:server": "bun --watch run server.ts",
    "build": "tsc -b && vite build",
    "preview": "bun run server.ts",
    "lint": "eslint .",
    "sync-schema": "bun node_modules/@businessdash/sdk/dist/cli.js sync-schema --config biab.config.ts",
    "sync-content": "bun node_modules/@businessdash/sdk/dist/cli.js sync-content --config biab.config.ts",
    "print-schema": "bun node_modules/@businessdash/sdk/dist/cli.js print-schema --config biab.config.ts",
    "sync-data-model": "bun node_modules/@businessdash/sdk/dist/cli.js sync-data-model --config biab.data-model.config.ts",
    "print-data-model": "bun node_modules/@businessdash/sdk/dist/cli.js print-data-model --config biab.data-model.config.ts"
  },
  "dependencies": {
    "@businessdash/sdk": "^0.9.70",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.1.18",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  },
  "pnpm": {
    "overrides": {
      "shell-quote": "^1.8.4"
    }
  }
}
