<!-- The business's reviews (ReviewsController). The rating and its bars come
     from the marketing bundle; the platform filter and "Show more" are plain
     links. Writing one is <bd-review-writer> (Public/shop/reviews-elements.js):
     signed out, it's a link to sign in. -->
#extend("base"):
  #export("title"):Reviews#endexport
  #export("head"):
    <link rel="stylesheet" href="/bd-pages.css">
    <link rel="stylesheet" href="/bd-reviews.css">
  #endexport
  #export("mainClass"):bd-page#endexport
  #export("scripts"):#if(configured):<script type="module" src="/shop/reviews-elements.js"></script>#endif#endexport
  #export("content"):
    <div class="bd-section__lead">
      <span class="bd-section__eyebrow">Reviews</span>
      <h1 class="bd-section__title">What customers say</h1>
    </div>
    #if(!configured):
      <div class="bd-empty">Reviews aren't connected yet. Set BD_API_KEY and BD_SITE_ID, and your rating and reviews appear here.</div>
    #else:
      <section class="reviews-summary" aria-label="#if(hasAverage):Rating#else:Write a review#endif">
        #if(hasAverage):
          <div class="reviews-summary__score">
            <span class="reviews-summary__average">#(average)</span>
            <span class="review-stars" role="img" aria-label="#(average) out of 5">#(averageStars)</span>
            <span class="reviews-summary__count">#(totalLabel)</span>
          </div>
          <ul class="reviews-bars">
            #for(bar in bars):
              <li aria-label="#(bar.stars) stars: #(bar.count)">
                <span>#(bar.stars) ★</span>
                <span class="reviews-bars__track"><span class="reviews-bars__fill" style="#(bar.width)"></span></span>
                <span>#(bar.count)</span>
              </li>
            #endfor
          </ul>
        #endif
        <div class="reviews-summary__write">
          <bd-review-writer data-write-url="/reviews/write" data-sign-in-href="/my-account?next=%2Freviews">
            <script type="application/json">#unsafeHTML(writerJSON)</script>
          </bd-review-writer>
        </div>
      </section>

      #if(showFilter):
        <nav aria-label="Platform">
          <ul class="reviews-filter">
            #for(chip in chips):
              <li><a href="#(chip.href)" aria-current="#(chip.current)">#(chip.label)</a></li>
            #endfor
          </ul>
        </nav>
      #endif

      #if(count(cards) == 0):
        <p class="reviews-empty">#(emptyMessage)</p>
      #else:
        <ul class="review-wall">
          #for(card in cards):
            <li class="review-card" id="#(card.anchor)">
              <div class="review-card__head">
                #if(card.hasAvatar):
                  <img class="review-card__avatar" src="#(card.avatar)" alt="" loading="lazy">
                #else:
                  <span class="review-card__avatar" aria-hidden="true">#(card.initial)</span>
                #endif
                <div>
                  <p class="review-card__name">#(card.name)</p>
                  <p class="review-card__meta"><span class="review-stars" role="img" aria-label="#(card.ratingLabel)">#(card.stars)</span> · #(card.date)</p>
                </div>
              </div>
              <p class="review-card__text">#(card.text)</p>
              #if(card.hasPhotos):
                <ul class="review-card__photos" aria-label="Photos from the reviewer">
                  #for(photo in card.photos):
                    <li><img src="#(photo)" alt="" loading="lazy"></li>
                  #endfor
                </ul>
              #endif
              #if(card.hasFoot):
                <p class="review-card__foot">
                  #if(card.hasPlatform):<span class="review-card__platform">#(card.platform)</span>#endif
                  #if(card.verified):<span class="review-card__verified">✓ Verified</span>#endif
                  #if(card.hasLink):<a class="review-card__link" href="#(card.link)" target="_blank" rel="noopener noreferrer">Read on #(card.platform)</a>#endif
                </p>
              #endif
            </li>
          #endfor
        </ul>
        #if(hasMore):
          <p class="reviews-more"><a class="bd-btn bd-btn--ghost" href="#(moreHref)">Show more reviews</a></p>
        #endif
      #endif
    #endif
  #endexport
#endextend
