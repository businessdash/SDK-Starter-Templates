<!-- Back from Stripe's checkout: the order's payment status, by session id. -->
#extend("base"):
  #export("title"):Order — Store#endexport
  #export("head"):
    <link rel="stylesheet" href="/bd-pages.css">
    <link rel="stylesheet" href="/bd-shop.css">
  #endexport
  #export("subnav"):#extend("store-nav")#endexport
  #export("mainClass"):bd-page#endexport
  #export("scripts"):<script type="module" src="/shop/shop-elements.js"></script>#endexport
  #export("content"):
    <div class="bd-section__lead">
      <span class="bd-section__eyebrow">Shop</span>
      #if(paid):
        <h1 class="bd-section__title">Thank you for your order</h1>
        <p class="bd-section__sub">
          Your payment went through.#if(hasEmail): A receipt is on its way to #(email).#endif
        </p>
      #else:
        <h1 class="bd-section__title">Your order</h1>
        <p class="bd-section__sub">We're confirming your payment. You'll get an email when it's done.</p>
      #endif
    </div>
    <p><a class="bd-btn" href="/store">Continue shopping</a></p>
  #endexport
#endextend
