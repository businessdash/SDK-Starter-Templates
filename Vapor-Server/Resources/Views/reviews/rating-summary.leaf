<!-- The average with its stars and the number of reviews, a bar per star, and
     "Write a review" (<bd-review-writer>, Public/shop/reviews-elements.js,
     which posts to /reviews/write; signed out, it's a link to sign in).
     Before there are any reviews, just the writer. -->
<section class="reviews-summary" aria-label="#if(hasAverage):Rating#else:Write a review#endif">
  #if(hasAverage):
    <div class="reviews-summary__score">
      <span class="reviews-summary__average">#(average)</span>
      <span class="review-stars" role="img" aria-label="#(average) out of 5">#(averageStars)</span>
      <span class="reviews-summary__count">#(totalLabel)</span>
    </div>
    <ul class="reviews-bars">
      #for(bar in bars):
        <li aria-label="#(bar.stars) stars: #(bar.count)">
          <span>#(bar.stars) ★</span>
          <span class="reviews-bars__track"><span class="reviews-bars__fill" style="#(bar.width)"></span></span>
          <span>#(bar.count)</span>
        </li>
      #endfor
    </ul>
  #endif
  <div class="reviews-summary__write">
    <bd-review-writer data-write-url="/reviews/write" data-sign-in-href="/my-account?next=%2Freviews">
      <script type="application/json">#unsafeHTML(writerJSON)</script>
    </bd-review-writer>
  </div>
</section>
