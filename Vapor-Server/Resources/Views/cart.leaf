#extend("base"):
  #export("title"):Cart#endexport
  #export("head"):
    <link rel="stylesheet" href="/bd-pages.css">
    <link rel="stylesheet" href="/bd-shop.css">
  #endexport
  #export("subnav"):#extend("store-nav")#endexport
  #export("scripts"):<script type="module" src="/shop/shop-elements.js"></script>#endexport
  #export("content"):
    <h1>Cart</h1>

    #if(isEmpty):
      <p class="muted">Your cart is empty. <a href="/store">Browse the store</a>.</p>
    #else:
      <ul class="cart-lines">
        #for(line in lines):
          <li>
            <span>#(line.name)</span>
            <span class="muted">#(line.unitPrice) each × #(line.quantity)</span>
          </li>
        #endfor
      </ul>

      <!-- Totals arrive DECIMAL; product prices arrive in integer cents. -->
      <p class="total">Subtotal: #(subtotal)</p>

      <form method="post" action="/cart/clear">
        <button type="submit">Clear</button>
      </form>

      <form method="post" action="/cart/checkout">
        <button type="submit" class="button">Checkout</button>
      </form>
    #endif
  #endexport
#endextend
