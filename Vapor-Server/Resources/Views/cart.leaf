<!-- The cart (CartController), laid out from the shop's parts
     (Resources/Views/shop/): a line per item, the subtotal, and Clear and
     Checkout. -->
#extend("base"):
  #export("title"):Cart#endexport
  #export("head"):
    <link rel="stylesheet" href="/bd-pages.css">
    <link rel="stylesheet" href="/bd-shop.css">
  #endexport
  #export("subnav"):#extend("store-nav")#endexport
  #export("scripts"):<script type="module" src="/shop/shop-elements.js"></script>#endexport
  #export("content"):
    <h1>Cart</h1>

    #if(isEmpty):
      <p class="muted">Your cart is empty. <a href="/store">Browse the store</a>.</p>
    #else:
      <ul class="cart-lines">
        #for(line in lines):#extend("shop/cart-line")#endfor
      </ul>

      #extend("shop/cart-summary")
      #extend("shop/cart-actions")
    #endif
  #endexport
#endextend
