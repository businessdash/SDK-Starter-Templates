#extend("base"):
  #export("title"):Cart#endexport
  #export("content"):
    <h1>Cart</h1>

    #if(isEmpty):
      <p class="muted">Your cart is empty. <a href="/store">Browse the store</a>.</p>
    #else:
      <ul class="cart-lines">
        #for(line in lines):
          <li>
            <span>#(line.name)</span>
