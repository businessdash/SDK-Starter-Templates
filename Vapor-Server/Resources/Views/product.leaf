<!-- One product. StoreController.show reads the product, its reviews, add-ons
     and related products; shop/product-detail lays the page out from the
     shop's parts (Resources/Views/shop/, one file each): option photos,
     option and size buttons, the price for what's chosen, add to cart (POST
     /api/bd/cart/add), save, compare, share, add-ons, reviews, related and
     recently viewed. -->
#extend("base"):
  #export("title"):#(title)#endexport
  #export("head"):
    <link rel="stylesheet" href="/bd-pages.css">
    <link rel="stylesheet" href="/bd-shop.css">
  #endexport
  #export("subnav"):#extend("store-nav")#endexport
  #export("mainClass"):bd-page#endexport
  #export("scripts"):<script type="module" src="/shop/shop-elements.js"></script>#endexport
  #export("content"):
    #if(!configured):
      <div class="bd-empty">
        The store isn't connected yet. Set <code>BD_SITE_ID</code> and <code>BD_API_KEY</code> in <code>.env</code>.
      </div>
    #elseif(unavailable):
      <div class="bd-empty">The store is temporarily unavailable. Please check back soon.</div>
    #elseif(!found):
      <div class="bd-empty">That product isn't available. <a href="/store">Browse the store</a></div>
    #else:
      #extend("shop/product-detail")
    #endif
  #endexport
#endextend
