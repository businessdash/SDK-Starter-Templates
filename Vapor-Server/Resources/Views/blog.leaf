<!-- The post list: pinned first, category and tag filters, older posts.
     BlogController.index works out every link and label. It's laid out from
     the blog's parts (Resources/Views/blog/): the filters and a post card per
     post. -->
#extend("base"):
  #export("title"):#(title)#endexport
  #export("head"):
    <link rel="stylesheet" href="/bd-pages.css">
    <link rel="stylesheet" href="/bd-blog.css">
  #endexport
  #export("mainClass"):bd-page#endexport
  #export("content"):
    #if(!configured):
      <div class="bd-empty">The blog isn't connected yet. Add your BD env, then publish a post in Business Dash.</div>
    #else:
      <div class="bd-section__lead">
        <span class="bd-section__eyebrow">Blog</span>
        <h1 class="bd-section__title">#(heading)</h1>
        #if(hasDescription):<p class="bd-section__sub">#(description)</p>#endif
      </div>

      #extend("blog/blog-filters")

      #if(isEmpty):
        <div class="bd-empty">
          #if(filtered):
            No posts here yet.
          #else:
            No posts published yet. Write one in Business Dash and it'll appear here.
          #endif
        </div>
      #else:
        <ul class="posts">
          #for(post in posts):#extend("blog/post-card")#endfor
        </ul>
        #if(hasOlder):
          <p class="posts__more"><a class="bd-btn bd-btn--ghost" href="#(olderHref)">Older posts</a></p>
        #endif
      #endif
    #endif
  #endexport
#endextend
