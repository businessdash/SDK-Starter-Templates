<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>#import("title")</title>
  <link rel="stylesheet" href="/styles.css">
  <!-- Forms and quizzes are drawn on this server (Sources/App/Forms) in the
       SDK's bd-* classes: the SDK's own stylesheet, then /forms.css on top.
       Pinned to an exact version deliberately — a CDN link has no lockfile,
       so @latest would roll this page forward on somebody else's release. -->
  <link rel="stylesheet" href="https://esm.sh/@businessdash/sdk@0.9.98/bd-forms.css">
  <link rel="stylesheet" href="/forms.css">
  <!-- A page adds its own stylesheets here (the store's and blog's). A page
       that exports nothing leaves these hooks empty: Leaf skips an import
       nobody exported. -->
  #import("head")
  <!-- htmx: the sign-in screen checks boxes and changes steps with it, and a
       form or quiz re-renders on each change. Its morph swap (idiomorph)
       keeps what's being typed while the rest of a form updates. -->
  <script src="https://unpkg.com/htmx.org@2.0.4" integrity="sha384-HGfztofotfshcF7+8n44JQL2oJmowVChPTg48S+jvZoztPfvwD79OC/LTtG6dMp+" crossorigin="anonymous"></script>
  <script src="https://unpkg.com/idiomorph@0.7.4/dist/idiomorph-ext.min.js" integrity="sha384-SsScJKzATF/w6suEEdLbgYGsYFLzeKfOA6PY+/C5ZPxOSuA+ARquqtz/BZz9JWU8" crossorigin="anonymous"></script>
</head>
<body>
  #if(!configured):
    <div class="banner banner-setup">
      <strong>Not connected to BD.</strong>
      Copy <code>.env.example</code> to <code>.env</code> and set
      <code>BD_SITE_ID</code> + <code>BD_API_KEY</code>. Every section
      below is rendering its local fallback.
    </div>
  #endif

  <header class="site-header">
    <a class="brand" href="/">BD Vapor starter</a>
    <nav>
      <a href="/store">Store</a>
      <a href="/services">Services</a>
      <a href="/blog">Blog</a>
      <a href="/reviews">Reviews</a>
      <a href="/todos">Todos</a>
      <a href="/quiz">Quiz</a>
      <a href="/my-account">My account</a>
    </nav>
  </header>

  <!-- The store bar (Products, Plans, Wishlist, Compare, Cart) on store and plan pages. -->
  #import("subnav")

  <main class="#import("mainClass")">#import("content")</main>

  <footer class="site-footer">
    <p class="muted">Powered by BusinessDash</p>
  </footer>

  #import("scripts")
</body>
</html>
