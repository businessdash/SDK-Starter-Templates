<!-- The product list: search, category, price and rating filters with a sort.
     Each card saves to the wishlist or the comparison (<bd-save-buttons>), and
     <bd-compare-bar> shows the picks. StoreController.index works out every
     link and label. -->
#extend("base"):
  #export("title"):Store#endexport
  #export("head"):
    <link rel="stylesheet" href="/bd-pages.css">
    <link rel="stylesheet" href="/bd-shop.css">
  #endexport
  #export("subnav"):#extend("store-nav")#endexport
  #export("mainClass"):bd-page#endexport
  #export("scripts"):<script type="module" src="/shop/shop-elements.js"></script>#endexport
  #export("content"):
    <div class="bd-section__lead">
      <span class="bd-section__eyebrow">Shop</span>
      <h1 class="bd-section__title">Products</h1>
      <p class="bd-section__sub">Filter, sort, and open a product to choose its options and add it to your cart.</p>
    </div>

    #if(!configured):
      <div class="bd-empty">
        The store isn't connected yet. Set <code>BD_SITE_ID</code> and <code>BD_API_KEY</code> in <code>.env</code>.
      </div>
    #elseif(unavailable):
      <div class="bd-empty">The store is temporarily unavailable. Please check back soon.</div>
    #else:
      <div class="store-layout">
        <aside aria-label="Product filters" class="store-sidebar">
          <search>
            <form action="/store" method="get">
              <label class="bd-label" for="store-search">Search</label>
              <input autocomplete="off" class="bd-input" id="store-search" name="q" placeholder="Search products…" type="search" value="#(search)">
              #for(field in keepForSearch):<input type="hidden" name="#(field.name)" value="#(field.value)">#endfor
            </form>
          </search>

          #if(hasCategories):
            <div class="store-facet">
              <p class="store-facet__title">Category</p>
              <ul class="store-facet__list">
                <li>
                  <a class="store-facet__item#if(allActive): store-facet__item--active#endif" href="#(allHref)">All products</a>
                </li>
                #for(category in categories):
                  <li>
                    <a class="store-facet__item store-facet__item--row#if(category.active): store-facet__item--active#endif" href="#(category.href)">
                      <span>#(category.label)</span>
                      <span class="store-facet__count">#(category.productCount)</span>
                    </a>
                  </li>
                #endfor
              </ul>
            </div>
          #endif

          <form action="/store" class="store-facet" method="get">
            <p class="store-facet__title">Price</p>
            <div class="store-price">
              <input aria-label="Lowest price" class="bd-input" inputmode="decimal" name="priceMin" placeholder="#(priceMinPlaceholder)" value="#(priceMin)">
              <span aria-hidden="true" class="store-price__sep">–</span>
              <input aria-label="Highest price" class="bd-input" inputmode="decimal" name="priceMax" placeholder="#(priceMaxPlaceholder)" value="#(priceMax)">
            </div>
            #for(field in keepForPrice):<input type="hidden" name="#(field.name)" value="#(field.value)">#endfor
            <button class="bd-btn bd-btn--ghost store-price__apply" type="submit">Apply</button>
          </form>

          <div class="store-facet">
            <p class="store-facet__title">Rating</p>
            <ul class="store-facet__list">
              #for(rating in ratings):
                <li>
                  <a class="store-facet__item store-facet__rating#if(rating.active): store-facet__item--active#endif" href="#(rating.href)">
                    #unsafeHTML(rating.starsHTML)<span class="store-facet__count">&amp; up</span>
                  </a>
                </li>
              #endfor
            </ul>
          </div>

          #if(hasFilters):
            <a class="store-clear" href="/store">Clear all filters</a>
          #endif
        </aside>

        <div class="store-results">
          <div class="store-results__bar">
            <p class="bd-loading">#(countLabel)</p>
            <form action="/store" class="store-sort" method="get">
              <label for="store-sort">Sort</label>
              <select class="bd-select" id="store-sort" name="sort" onchange="this.form.requestSubmit()">
                #for(sort in sorts):
                  <option value="#(sort.value)"#if(sort.selected): selected#endif>#(sort.label)</option>
                #endfor
              </select>
              #for(field in keepForSort):<input type="hidden" name="#(field.name)" value="#(field.value)">#endfor
              <noscript><button class="bd-btn bd-btn--ghost" type="submit">Sort</button></noscript>
            </form>
          </div>

          #if(isEmpty):
            <div class="bd-empty">
              #if(hasFilters):
                No products match these filters. Try clearing a filter or broadening your search.
              #else:
                No live products yet. Add and publish products in the BD dashboard and they'll appear here.
              #endif
            </div>
          #else:
            <div class="bd-grid-3">
              #for(product in products):
                <div class="bd-card product-card">
                  <a class="product-card__link" href="#(product.href)">
                    <div class="product-card__media">
                      #if(product.hasImage):
                        <img alt="#(product.name)" class="product-card__img" loading="lazy" referrerpolicy="no-referrer" src="#(product.image)">
                      #else:
                        <div class="product-card__noimg">No image</div>
                      #endif
                      <div class="product-card__badges">
                        #if(product.isBestSeller):<span class="bd-badge">Best seller</span>#endif
                        #if(product.isNew):<span class="bd-badge">New</span>#endif
                        #if(product.isOnSale):<span class="bd-badge product-card__badge--sale">Sale</span>#endif
                      </div>
                    </div>
                    <div class="product-card__body">
                      <h3>#(product.name)</h3>
                      #if(product.hasReviews):
                        <div class="product-card__rating">
                          #unsafeHTML(product.starsHTML)
                          <span class="product-card__count">(#(product.reviewCount))</span>
                        </div>
                      #endif
                      <div class="product-card__price">
                        <span class="product-card__amount">#(product.price)</span>
                        #if(product.hasCompare):<span class="product-card__compare">#(product.compare)</span>#endif
                      </div>
                      #if(product.isLowStock):<span class="product-card__lowstock">Low stock</span>#endif
                    </div>
                  </a>
                  <div class="product-card__save">
                    <bd-save-buttons compact data-product="#(product.saveData)"></bd-save-buttons>
                  </div>
                </div>
              #endfor
            </div>
          #endif
          <bd-compare-bar></bd-compare-bar>
        </div>
      </div>
    #endif
  #endexport
#endextend
