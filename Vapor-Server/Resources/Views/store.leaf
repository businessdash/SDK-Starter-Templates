<!-- The product list: search, category, price and rating filters with a sort.
     StoreController.index works out every link and label. It's laid out from
     the shop's parts (Resources/Views/shop/, one file each): the filters, the
     sort, and a product card per product, which saves to the wishlist or the
     comparison (<bd-save-buttons>); shop/compare-bar shows the picks. -->
#extend("base"):
  #export("title"):Store#endexport
  #export("head"):
    <link rel="stylesheet" href="/bd-pages.css">
    <link rel="stylesheet" href="/bd-shop.css">
  #endexport
  #export("subnav"):#extend("store-nav")#endexport
  #export("mainClass"):bd-page#endexport
  #export("scripts"):<script type="module" src="/shop/shop-elements.js"></script>#endexport
  #export("content"):
    <div class="bd-section__lead">
      <span class="bd-section__eyebrow">Shop</span>
      <h1 class="bd-section__title">Products</h1>
      <p class="bd-section__sub">Filter, sort, and open a product to choose its options and add it to your cart.</p>
    </div>

    #if(!configured):
      <div class="bd-empty">
        The store isn't connected yet. Set <code>BD_SITE_ID</code> and <code>BD_API_KEY</code> in <code>.env</code>.
      </div>
    #elseif(unavailable):
      <div class="bd-empty">The store is temporarily unavailable. Please check back soon.</div>
    #else:
      <div class="store-layout">
        <aside aria-label="Product filters" class="store-sidebar">
          #extend("shop/store-search")
          #extend("shop/category-filter")
          #extend("shop/price-filter")
          #extend("shop/rating-filter")
          #if(hasFilters):#extend("shop/clear-filters")#endif
        </aside>

        <div class="store-results">
          <div class="store-results__bar">
            <p class="bd-loading">#(countLabel)</p>
            #extend("shop/sort-select")
          </div>

          #if(isEmpty):
            <div class="bd-empty">
              #if(hasFilters):
                No products match these filters. Try clearing a filter or broadening your search.
              #else:
                No live products yet. Add and publish products in the BD dashboard and they'll appear here.
              #endif
            </div>
          #else:
            #extend("shop/product-grid")
          #endif
          #extend("shop/compare-bar")
        </div>
      </div>
    #endif
  #endexport
#endextend
