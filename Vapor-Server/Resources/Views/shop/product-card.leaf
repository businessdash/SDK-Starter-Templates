<!-- A product in the list, `product`: photo with Best seller / New / Sale
     badges, name, stars, price, Low stock, and ♡ Save and ⇄ Compare. -->
<div class="bd-card product-card">
  <a class="product-card__link" href="#(product.href)">
    <div class="product-card__media">
      #if(product.hasImage):
        <img alt="#(product.name)" class="product-card__img" loading="lazy" referrerpolicy="no-referrer" src="#(product.image)">
      #else:
        <div class="product-card__noimg">No image</div>
      #endif
      <div class="product-card__badges">
        #if(product.isBestSeller):<span class="bd-badge">Best seller</span>#endif
        #if(product.isNew):<span class="bd-badge">New</span>#endif
        #if(product.isOnSale):<span class="bd-badge product-card__badge--sale">Sale</span>#endif
      </div>
    </div>
    <div class="product-card__body">
      <h3>#(product.name)</h3>
      #if(product.hasReviews):
        <div class="product-card__rating">
          #unsafeHTML(product.starsHTML)
          <span class="product-card__count">(#(product.reviewCount))</span>
        </div>
      #endif
      <div class="product-card__price">
        <span class="product-card__amount">#(product.price)</span>
        #if(product.hasCompare):<span class="product-card__compare">#(product.compare)</span>#endif
      </div>
      #if(product.isLowStock):<span class="product-card__lowstock">Low stock</span>#endif
    </div>
  </a>
  <div class="product-card__save">
    <bd-save-buttons compact data-product="#(product.saveData)"></bd-save-buttons>
  </div>
</div>
