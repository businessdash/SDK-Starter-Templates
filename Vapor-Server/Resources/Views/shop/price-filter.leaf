<!-- Lowest and highest price, with Apply (?priceMin, ?priceMax). -->
<form action="/store" class="store-facet" method="get">
  <p class="store-facet__title">Price</p>
  <div class="store-price">
    <input aria-label="Lowest price" class="bd-input" inputmode="decimal" name="priceMin" placeholder="#(priceMinPlaceholder)" value="#(priceMin)">
    <span aria-hidden="true" class="store-price__sep">–</span>
    <input aria-label="Highest price" class="bd-input" inputmode="decimal" name="priceMax" placeholder="#(priceMaxPlaceholder)" value="#(priceMax)">
  </div>
  #for(field in keepForPrice):<input type="hidden" name="#(field.name)" value="#(field.value)">#endfor
  <button class="bd-btn bd-btn--ghost store-price__apply" type="submit">Apply</button>
</form>
