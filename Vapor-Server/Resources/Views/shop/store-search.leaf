<!-- Search the products (?q=); Enter searches. -->
<search>
  <form action="/store" method="get">
    <label class="bd-label" for="store-search">Search</label>
    <input autocomplete="off" class="bd-input" id="store-search" name="q" placeholder="Search products…" type="search" value="#(search)">
    #for(field in keepForSearch):<input type="hidden" name="#(field.name)" value="#(field.value)">#endfor
  </form>
</search>
