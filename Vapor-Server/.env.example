# ═══════════════════════════════════════════════════════════════════
# BIAB Web Content SDK — Vapor starter
#
# Easiest path: the guided wizard in your BIAB dashboard —
#   Settings → Web Content SDK
#
# Vapor has no bundler inlining values into a browser bundle, so unlike the
# Vite/Next starters there is no PUBLIC_ prefix convention. Nothing below
# reaches the browser unless a Leaf template prints it.
# ═══════════════════════════════════════════════════════════════════

BIAB_HOST=https://www.biab.app
BIAB_SITE_ID=

# A SERVER holds the secret key — it never leaves this process. (The native
# Swift starter is the opposite case and takes a publishable pk_ token,
# because an app ships its credential inside the binary.)
BIAB_API_KEY=

# HMAC secret for the BIAB → this-app revalidate webhook (`whsec_…`).
BIAB_REVALIDATION_SECRET=

# Origin sent on every server-to-server call. A server has no browser Origin
# but the platform gates on it, so this must be the site's real public origin.
BIAB_SITE_ORIGIN=http://localhost:8080

# Seconds to cache marketing/catalog reads. The revalidate webhook busts these
# by tag on publish, so this is a floor, not a staleness budget.
BIAB_CACHE_TTL=300
